<!DOCTYPE html>
<html lang="en">
<head>
  <base target="_top">
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#3d5afe">
  <title><?= appTitle ?></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
/* =====================================================================
   SUCCESS COACHING CLASSES PORTAL — DESIGN SYSTEM
   All colours, radii, shadows and spacing are tokens. Do not hard-code
   values in pages; change the tokens here to re-brand the whole portal.
   ===================================================================== */
:root {
  --primary: #3d5afe; --primary-600: #2f47d9; --primary-700: #2538b0; --primary-50: #eef1ff; --primary-100: #dfe4ff;
  --secondary: #0f9d9a; --secondary-50: #e3f6f5;
  --bg: #f4f6fb; --surface: #ffffff; --surface-2: #f8fafc;
  --text: #0f172a; --text-2: #334155; --muted: #64748b;
  --border: #e2e8f0; --border-strong: #cbd5e1;
  --success: #15803d; --success-50: #e6f6ec;
  --warning: #b45309; --warning-50: #fef3e2;
  --error: #b91c1c; --error-50: #fdeaea;
  --info: #0369a1; --info-50: #e3f2fb;
  --sidebar: #0c1a3f; --sidebar-text: #c3cdee;
  --radius-sm: 8px; --radius: 12px; --radius-lg: 18px;
  --shadow-sm: 0 1px 2px rgba(15, 23, 42, .06);
  --shadow: 0 4px 16px rgba(15, 23, 42, .08);
  --shadow-lg: 0 20px 48px rgba(15, 23, 42, .22);
  --font: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif;
  --fs-xs: 12px; --fs-sm: 13.5px; --fs-md: 15px; --fs-lg: 18px; --fs-xl: 22px; --fs-2xl: 28px;
  --sp-1: 4px; --sp-2: 8px; --sp-3: 12px; --sp-4: 16px; --sp-5: 24px; --sp-6: 32px;
}
* { box-sizing: border-box; }
html, body { margin: 0; min-height: 100%; }
body { font-family: var(--font); background: var(--bg); color: var(--text); font-size: var(--fs-md); line-height: 1.5; -webkit-font-smoothing: antialiased; }
h1, h2, h3, h4, p { margin: 0; }
h1 { font-size: var(--fs-xl); font-weight: 700; letter-spacing: -.01em; }
h2 { font-size: var(--fs-lg); font-weight: 650; }
h3 { font-size: var(--fs-md); font-weight: 650; }
a { color: var(--primary); }
button { font: inherit; color: inherit; }
img, svg { max-width: 100%; }
.muted { color: var(--muted); } .small { font-size: var(--fs-sm); } .xs { font-size: var(--fs-xs); }
.bold { font-weight: 600; } .right { text-align: right; } .center { text-align: center; } .nowrap { white-space: nowrap; }
.sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
:focus-visible { outline: 3px solid rgba(61, 90, 254, .5); outline-offset: 2px; border-radius: 6px; }
.icon { width: 1.15em; height: 1.15em; flex: none; vertical-align: -.2em; }
.row { display: flex; align-items: center; gap: var(--sp-3); flex-wrap: wrap; }
.row.between { justify-content: space-between; } .row.nowrapflex { flex-wrap: nowrap; }
.stack { display: flex; flex-direction: column; gap: var(--sp-3); } .stack-lg { display: flex; flex-direction: column; gap: var(--sp-5); }
.grow { flex: 1; min-width: 0; }
.hidden { display: none !important; }

/* ---------- buttons ---------- */
.btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 9px 16px; border-radius: 10px; border: 1px solid transparent; background: var(--primary); color: #fff; font-weight: 600; font-size: var(--fs-sm); cursor: pointer; text-decoration: none; transition: background .15s, box-shadow .15s, transform .05s; min-height: 40px; white-space: nowrap; }
.btn:hover { background: var(--primary-600); } .btn:active { transform: translateY(1px); }
.btn[disabled], .btn.loading { opacity: .65; cursor: not-allowed; pointer-events: none; }
.btn.secondary { background: #fff; color: var(--text-2); border-color: var(--border-strong); }
.btn.secondary:hover { background: var(--surface-2); }
.btn.ghost { background: transparent; color: var(--text-2); } .btn.ghost:hover { background: rgba(15, 23, 42, .06); }
.btn.danger { background: var(--error); } .btn.danger:hover { background: #991b1b; }
.btn.success { background: var(--success); } .btn.success:hover { background: #166534; }
.btn.sm { padding: 5px 10px; min-height: 32px; font-size: var(--fs-xs); border-radius: 8px; }
.btn.icon-only { padding: 8px; min-width: 40px; } .btn.sm.icon-only { min-width: 32px; padding: 5px; }
.btn.block { width: 100%; }
.spinner { width: 16px; height: 16px; border: 2px solid rgba(255, 255, 255, .5); border-top-color: #fff; border-radius: 50%; animation: spin .7s linear infinite; }
.btn.secondary .spinner, .btn.ghost .spinner { border-color: rgba(15, 23, 42, .25); border-top-color: var(--primary); }
@keyframes spin { to { transform: rotate(360deg); } }

/* ---------- forms ---------- */
.field { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
.field > label, .field > .lbl { font-size: var(--fs-sm); font-weight: 600; color: var(--text-2); }
.field .req { color: var(--error); }
.help { font-size: var(--fs-xs); color: var(--muted); }
.input, .select, .textarea { width: 100%; padding: 10px 12px; border: 1px solid var(--border-strong); border-radius: 10px; background: #fff; color: var(--text); font: inherit; font-size: var(--fs-md); min-height: 42px; transition: border-color .15s, box-shadow .15s; }
.textarea { min-height: 88px; resize: vertical; }
.input:hover, .select:hover, .textarea:hover { border-color: #94a3b8; }
.input:focus, .select:focus, .textarea:focus { outline: none; border-color: var(--primary); box-shadow: 0 0 0 3px rgba(61, 90, 254, .18); }
.input[aria-invalid=true] { border-color: var(--error); }
.form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--sp-4); }
.form-grid .full { grid-column: 1 / -1; }
.checks { display: flex; flex-wrap: wrap; gap: 8px; }
.check { display: inline-flex; align-items: center; gap: 8px; padding: 7px 12px; border: 1px solid var(--border-strong); border-radius: 999px; cursor: pointer; font-size: var(--fs-sm); background: #fff; user-select: none; }
.check input { accent-color: var(--primary); width: 16px; height: 16px; margin: 0; }
.check:has(input:checked) { background: var(--primary-50); border-color: var(--primary); color: var(--primary-700); }
.pw-wrap { position: relative; } .pw-wrap .input { padding-right: 44px; }
.pw-wrap button { position: absolute; right: 4px; top: 50%; transform: translateY(-50%); }
.alert { display: flex; gap: 10px; align-items: flex-start; padding: 12px 14px; border-radius: 10px; font-size: var(--fs-sm); border: 1px solid transparent; }
.alert.error { background: var(--error-50); color: var(--error); border-color: #f5c2c2; }
.alert.success { background: var(--success-50); color: var(--success); border-color: #b7e2c6; }
.alert.warning { background: var(--warning-50); color: var(--warning); border-color: #f3d9a8; }
.alert.info { background: var(--info-50); color: var(--info); border-color: #b8dcf1; }
.filebox { border: 1.5px dashed var(--border-strong); border-radius: 12px; padding: 14px; background: var(--surface-2); }

/* ---------- cards, stats ---------- */
.card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow-sm); }
.card-pad { padding: 20px; }
.card-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 16px 20px; border-bottom: 1px solid var(--border); }
.card-body { padding: 16px 20px; }
.grid { display: grid; gap: var(--sp-4); }
.grid.c2 { grid-template-columns: repeat(2, minmax(0, 1fr)); } .grid.c3 { grid-template-columns: repeat(3, minmax(0, 1fr)); } .grid.c4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
.stat { display: flex; align-items: center; gap: 14px; padding: 18px; }
.stat .ico { width: 46px; height: 46px; border-radius: 12px; display: grid; place-items: center; background: var(--primary-50); color: var(--primary); font-size: 22px; flex: none; }
.stat .ico.success { background: var(--success-50); color: var(--success); } .stat .ico.warning { background: var(--warning-50); color: var(--warning); }
.stat .ico.error { background: var(--error-50); color: var(--error); } .stat .ico.secondary { background: var(--secondary-50); color: var(--secondary); }
.stat .val { font-size: var(--fs-2xl); font-weight: 700; line-height: 1.1; letter-spacing: -.02em; }
.stat .lbl { font-size: var(--fs-sm); color: var(--muted); }
.list { list-style: none; margin: 0; padding: 0; }
.list-item { display: flex; align-items: center; gap: 12px; padding: 12px 20px; border-bottom: 1px solid var(--border); }
.list-item:last-child { border-bottom: 0; }
.list-item.click { cursor: pointer; } .list-item.click:hover { background: var(--surface-2); }
.avatar { width: 38px; height: 38px; border-radius: 50%; background: var(--primary-100); color: var(--primary-700); display: grid; place-items: center; font-weight: 700; font-size: var(--fs-sm); flex: none; }
.avatar.lg { width: 56px; height: 56px; font-size: var(--fs-lg); }
.progress { height: 8px; border-radius: 999px; background: var(--border); overflow: hidden; }
.progress > span { display: block; height: 100%; background: var(--primary); border-radius: 999px; }
.progress.success > span { background: var(--success); } .progress.warning > span { background: #d97706; } .progress.error > span { background: var(--error); }
.tag { white-space: nowrap; display: inline-flex; align-items: center; padding: 2px 9px; border-radius: 999px; background: var(--primary-50); color: var(--primary-700); font-size: var(--fs-xs); font-weight: 600; }

/* ---------- badges ---------- */
.badge { display: inline-flex; align-items: center; gap: 5px; padding: 3px 10px; border-radius: 999px; font-size: var(--fs-xs); font-weight: 600; background: #eef2f7; color: var(--text-2); white-space: nowrap; }
.badge::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: currentColor; opacity: .8; }
.badge.success { background: var(--success-50); color: var(--success); } .badge.warning { background: var(--warning-50); color: var(--warning); }
.badge.error { background: var(--error-50); color: var(--error); } .badge.info { background: var(--info-50); color: var(--info); }
.badge.primary { background: var(--primary-50); color: var(--primary-700); }

/* ---------- tables ---------- */
.table-wrap { overflow-x: auto; border: 1px solid var(--border); border-radius: var(--radius); background: #fff; box-shadow: var(--shadow-sm); }
.table { width: 100%; border-collapse: collapse; font-size: var(--fs-sm); }
.table th { text-align: left; font-weight: 600; color: var(--muted); background: var(--surface-2); padding: 11px 16px; border-bottom: 1px solid var(--border); white-space: nowrap; font-size: var(--fs-xs); text-transform: uppercase; letter-spacing: .04em; }
.table td { padding: 12px 16px; border-bottom: 1px solid var(--border); vertical-align: middle; }
.table tr:last-child td { border-bottom: 0; }
.table tbody tr:hover { background: #fafbff; }
.table td.actions { text-align: right; white-space: nowrap; }
.table td:first-child { min-width: 160px; }
.table .num { text-align: right; font-variant-numeric: tabular-nums; }
.toolbar { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 14px; align-items: center; }
.toolbar .search { position: relative; flex: 1 1 240px; min-width: 200px; }
.toolbar .search .icon { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--muted); }
.toolbar .search .input { padding-left: 38px; }
.toolbar .select { width: auto; min-width: 130px; }
.pager { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 14px; flex-wrap: wrap; color: var(--muted); font-size: var(--fs-sm); }
.tabs { display: flex; gap: 4px; border-bottom: 1px solid var(--border); margin-bottom: 18px; overflow-x: auto; }
.tab { padding: 10px 16px; border: 0; background: none; cursor: pointer; font-weight: 600; color: var(--muted); border-bottom: 2px solid transparent; white-space: nowrap; }
.tab:hover { color: var(--text); } .tab[aria-selected=true] { color: var(--primary); border-bottom-color: var(--primary); }

/* ---------- skeleton / empty ---------- */
.skeleton { border-radius: 8px; background: linear-gradient(90deg, #eceff5 25%, #f6f8fb 40%, #eceff5 65%); background-size: 400% 100%; animation: shimmer 1.4s ease infinite; }
@keyframes shimmer { 0% { background-position: 100% 0; } 100% { background-position: 0 0; } }
.empty { text-align: center; padding: 48px 20px; color: var(--muted); }
.empty .ico { width: 64px; height: 64px; border-radius: 50%; background: var(--primary-50); color: var(--primary); display: grid; place-items: center; margin: 0 auto 14px; font-size: 28px; }
.empty h3 { color: var(--text); margin-bottom: 4px; }

/* ---------- app shell ---------- */
.shell { display: flex; min-height: 100vh; }
.sidebar { width: 264px; background: var(--sidebar); color: var(--sidebar-text); position: fixed; inset: 0 auto 0 0; display: flex; flex-direction: column; z-index: 60; transition: transform .25s ease; }
.brand { display: flex; align-items: center; gap: 12px; padding: 20px 18px 14px; }
.brand .logo { width: 44px; height: 44px; border-radius: 12px; background: #fff; display: grid; place-items: center; overflow: hidden; flex: none; color: var(--primary); font-weight: 800; }
.brand .logo img { width: 100%; height: 100%; object-fit: contain; }
.brand .name { color: #fff; font-weight: 700; font-size: 14px; line-height: 1.25; letter-spacing: .02em; text-transform: uppercase; }
.brand .role { font-size: var(--fs-xs); color: #8fa0d6; text-transform: capitalize; }
.nav { padding: 8px 12px; overflow-y: auto; flex: 1; }
.nav a { display: flex; align-items: center; gap: 12px; padding: 10px 12px; margin-bottom: 2px; border-radius: 10px; color: var(--sidebar-text); text-decoration: none; font-weight: 500; font-size: var(--fs-sm); cursor: pointer; }
.nav a:hover { background: rgba(255, 255, 255, .08); color: #fff; }
.nav a[aria-current=page] { background: var(--primary); color: #fff; box-shadow: 0 4px 12px rgba(61, 90, 254, .4); }
.nav .count { margin-left: auto; background: #f43f5e; color: #fff; border-radius: 999px; font-size: 11px; padding: 1px 7px; font-weight: 700; }
.side-foot { padding: 14px 18px; border-top: 1px solid rgba(255, 255, 255, .08); font-size: var(--fs-xs); color: #8fa0d6; }
.main { margin-left: 264px; flex: 1; min-width: 0; display: flex; flex-direction: column; }
.topbar { position: sticky; top: 0; z-index: 40; background: rgba(255, 255, 255, .92); backdrop-filter: blur(10px); border-bottom: 1px solid var(--border); height: 64px; display: flex; align-items: center; gap: 12px; padding: 0 24px; }
.topbar h2 { font-size: var(--fs-lg); }
.icon-btn.menu-btn { display: none; }
.icon-btn { position: relative; width: 42px; height: 42px; border-radius: 12px; border: 1px solid var(--border); background: #fff; display: grid; place-items: center; cursor: pointer; color: var(--text-2); font-size: 20px; }
.icon-btn:hover { background: var(--surface-2); }
.icon-btn .dot { position: absolute; top: -5px; right: -5px; background: #f43f5e; color: #fff; border-radius: 999px; font-size: 11px; min-width: 18px; height: 18px; display: grid; place-items: center; font-weight: 700; padding: 0 4px; border: 2px solid #fff; }
.user-chip { display: flex; align-items: center; gap: 10px; padding: 4px 10px 4px 4px; border-radius: 999px; border: 1px solid var(--border); background: #fff; cursor: pointer; }
.user-chip .who { line-height: 1.2; text-align: left; } .user-chip .who b { font-size: var(--fs-sm); display: block; max-width: 140px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; } .user-chip .who span { font-size: 11px; color: var(--muted); }
.menu { position: absolute; right: 24px; top: 60px; background: #fff; border: 1px solid var(--border); border-radius: 12px; box-shadow: var(--shadow); min-width: 210px; padding: 6px; z-index: 70; }
.menu button { display: flex; width: 100%; gap: 10px; align-items: center; padding: 10px 12px; border: 0; background: none; border-radius: 8px; cursor: pointer; text-align: left; font-size: var(--fs-sm); }
.menu button:hover { background: var(--surface-2); }
.view { padding: 24px; width: 100%; max-width: 1280px; margin: 0 auto; outline: none; }
.page-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; flex-wrap: wrap; margin-bottom: 20px; }
.page-head p { color: var(--muted); margin-top: 2px; }
.scrim { position: fixed; inset: 0; background: rgba(15, 23, 42, .5); z-index: 55; display: none; }
.bottom-nav { display: none; }

/* ---------- modal / toast ---------- */
.modal-back { position: fixed; inset: 0; background: rgba(15, 23, 42, .55); display: flex; align-items: center; justify-content: center; padding: 16px; z-index: 100; animation: fade .15s ease; }
.modal { background: #fff; border-radius: var(--radius-lg); box-shadow: var(--shadow-lg); width: 100%; max-width: 540px; max-height: 92vh; display: flex; flex-direction: column; animation: pop .18s ease; }
.modal.lg { max-width: 820px; } .modal.sm { max-width: 420px; }
.modal-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 18px 22px; border-bottom: 1px solid var(--border); }
.modal-body { padding: 20px 22px; overflow-y: auto; }
.modal-foot { padding: 14px 22px; border-top: 1px solid var(--border); display: flex; justify-content: flex-end; gap: 10px; flex-wrap: wrap; }
@keyframes fade { from { opacity: 0; } } @keyframes pop { from { opacity: 0; transform: translateY(10px) scale(.98); } }
#toasts { position: fixed; z-index: 200; top: 16px; right: 16px; display: flex; flex-direction: column; gap: 10px; max-width: min(92vw, 380px); }
.toast { display: flex; gap: 10px; align-items: flex-start; padding: 12px 14px; border-radius: 12px; background: #0f172a; color: #fff; box-shadow: var(--shadow); font-size: var(--fs-sm); animation: pop .2s ease; }
.toast.success { background: #14532d; } .toast.error { background: #7f1d1d; } .toast .icon { margin-top: 2px; }

/* ---------- auth screen ---------- */
.auth { min-height: 100vh; display: grid; grid-template-columns: 1.05fr 1fr; }
.auth-hero { background: radial-gradient(1200px 500px at 0% 0%, #4f6bff 0%, transparent 60%), linear-gradient(140deg, #14267a, #2f47d9 55%, #0f9d9a); color: #fff; padding: 48px; display: flex; flex-direction: column; justify-content: space-between; }
.auth-hero .logo { width: 72px; height: 72px; border-radius: 20px; background: #fff; display: grid; place-items: center; color: var(--primary); font-weight: 800; font-size: 26px; overflow: hidden; box-shadow: 0 10px 30px rgba(0, 0, 0, .25); }
.auth-hero .logo img { width: 100%; height: 100%; object-fit: contain; }
.auth-hero h1 { font-size: 34px; line-height: 1.15; margin-top: 22px; text-transform: uppercase; letter-spacing: .01em; }
.auth-hero .tagline { opacity: .9; margin-top: 10px; font-size: var(--fs-lg); max-width: 420px; }
.auth-hero ul { list-style: none; padding: 0; margin: 28px 0 0; display: grid; gap: 12px; opacity: .95; }
.auth-hero li { display: flex; gap: 10px; align-items: center; }
.auth-form-wrap { display: grid; place-items: center; padding: 32px 20px; }
.auth-card { width: 100%; max-width: 420px; }
.auth-card h2 { font-size: var(--fs-xl); margin-bottom: 4px; }
.auth-mobile-brand { display: none; }
.role-pick { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
.role-pick button { padding: 10px; border-radius: 10px; border: 1px solid var(--border-strong); background: #fff; cursor: pointer; font-weight: 600; }
.role-pick button[aria-pressed=true] { background: var(--primary-50); border-color: var(--primary); color: var(--primary-700); }

/* ---------- attendance ---------- */
.att-row { display: flex; align-items: center; gap: 12px; padding: 12px 16px; border-bottom: 1px solid var(--border); flex-wrap: wrap; }
.att-row:last-child { border-bottom: 0; }
.att-row.absent { background: #fff7f7; }
.att-row .who { flex: 1; min-width: 150px; }
.seg { display: inline-flex; border: 1px solid var(--border-strong); border-radius: 12px; overflow: hidden; background: #fff; }
.seg button { border: 0; background: #fff; padding: 10px 18px; min-height: 44px; font-weight: 600; cursor: pointer; color: var(--text-2); font-size: var(--fs-sm); }
.seg button + button { border-left: 1px solid var(--border-strong); }
.seg button[aria-pressed=true].p { background: var(--success); color: #fff; } .seg button[aria-pressed=true].a { background: var(--error); color: #fff; }
.att-note { flex-basis: 100%; }
.sticky-bar { position: sticky; bottom: 0; background: rgba(255, 255, 255, .96); backdrop-filter: blur(6px); border-top: 1px solid var(--border); padding: 12px 16px; display: flex; align-items: center; gap: 12px; justify-content: space-between; flex-wrap: wrap; border-radius: 0 0 var(--radius) var(--radius); }
.donut { position: relative; width: 132px; height: 132px; flex: none; }
.donut .c { position: absolute; inset: 0; display: grid; place-items: center; text-align: center; font-weight: 700; font-size: 26px; line-height: 1; }
.donut .c small { display: block; font-size: 11px; color: var(--muted); font-weight: 500; margin-top: 4px; }
.day-chip { display: inline-flex; flex-direction: column; align-items: center; min-width: 54px; padding: 8px 10px; border-radius: 10px; background: var(--surface-2); border: 1px solid var(--border); font-size: var(--fs-xs); }
.alert-strip { display: grid; gap: 8px; margin-bottom: 20px; }
.alert-strip .alert { cursor: pointer; align-items: center; }
.tt { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 10px; }
.tt-col { background: #fff; border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; min-height: 120px; }
.tt-col.today { border-color: var(--primary); box-shadow: 0 0 0 2px var(--primary-100); }
.tt-col h4 { padding: 8px 10px; background: var(--surface-2); font-size: var(--fs-xs); text-transform: uppercase; letter-spacing: .05em; color: var(--muted); border-bottom: 1px solid var(--border); }
.tt-col.today h4 { background: var(--primary); color: #fff; }
.tt-slot { padding: 8px 10px; border-bottom: 1px solid var(--border); font-size: var(--fs-xs); }
.tt-slot:last-child { border-bottom: 0; } .tt-slot b { display: block; font-size: var(--fs-sm); }
.receipt-box { border: 1px solid var(--border); border-radius: 12px; padding: 14px; background: var(--surface-2); }
.kv { display: grid; grid-template-columns: 140px 1fr; gap: 6px 12px; font-size: var(--fs-sm); } .kv dt { color: var(--muted); } .kv dd { margin: 0; font-weight: 500; }
.picker-list { border: 1px solid var(--border); border-radius: 10px; max-height: 220px; overflow-y: auto; background: #fff; margin-top: 4px; }
.picker-list button { display: flex; width: 100%; justify-content: space-between; gap: 10px; padding: 9px 12px; border: 0; background: none; cursor: pointer; text-align: left; font-size: var(--fs-sm); }
.picker-list button:hover { background: var(--primary-50); }
.chosen { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 10px 12px; border: 1px solid var(--primary); border-radius: 10px; background: var(--primary-50); }

/* ---------- responsive ---------- */
@media (max-width: 1100px) { .grid.c4 { grid-template-columns: repeat(2, minmax(0, 1fr)); } .tt { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
@media (max-width: 960px) {
  .sidebar { transform: translateX(-100%); box-shadow: var(--shadow-lg); }
  .sidebar.open { transform: none; } .sidebar.open ~ .scrim, .scrim.show { display: block; }
  .main { margin-left: 0; } .icon-btn.menu-btn { display: grid; }
  .topbar { padding: 0 14px; } .view { padding: 16px 14px 96px; }
  .grid.c3 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .bottom-nav { display: flex; position: fixed; left: 0; right: 0; bottom: 0; z-index: 50; background: #fff; border-top: 1px solid var(--border); padding: 6px 6px calc(6px + env(safe-area-inset-bottom)); justify-content: space-around; box-shadow: 0 -4px 16px rgba(15, 23, 42, .06); }
  .bottom-nav a { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; display: flex; flex-direction: column; align-items: center; gap: 2px; padding: 6px 2px; font-size: 10.5px; color: var(--muted); text-decoration: none; border-radius: 10px; font-weight: 600; cursor: pointer; }
  .bottom-nav a .icon { font-size: 21px; } .bottom-nav a[aria-current=page] { color: var(--primary); background: var(--primary-50); }
  .sticky-bar { bottom: calc(64px + env(safe-area-inset-bottom)); border-radius: 0; box-shadow: 0 -6px 16px rgba(15, 23, 42, .08); }
  .user-chip .who { display: none; } .user-chip { padding: 4px; } .menu { right: 12px; }
  .auth { grid-template-columns: 1fr; } .auth-hero { display: none; }
  .auth-mobile-brand { display: flex; align-items: center; gap: 12px; margin-bottom: 22px; }
  .auth-mobile-brand .logo { width: 52px; height: 52px; border-radius: 14px; background: var(--primary); color: #fff; display: grid; place-items: center; font-weight: 800; overflow: hidden; }
  .auth-mobile-brand .logo img { width: 100%; height: 100%; object-fit: contain; background: #fff; }
}
@media (max-width: 760px) {
  .tt { grid-template-columns: 1fr; } .form-grid { grid-template-columns: 1fr; }
  .grid.c2, .grid.c3 { grid-template-columns: 1fr; }
  .table.responsive thead { display: none; }
  .table.responsive, .table.responsive tbody, .table.responsive tr, .table.responsive td { display: block; width: 100%; }
  .table.responsive tr { padding: 12px 14px; border-bottom: 1px solid var(--border); }
  .table.responsive td { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 6px 12px; padding: 4px 0; border: 0; text-align: right; }
  .table.responsive td::before { content: attr(data-label); font-weight: 600; color: var(--muted); text-align: left; font-size: var(--fs-xs); text-transform: uppercase; letter-spacing: .04em; }
  .table.responsive td.actions { justify-content: flex-start; padding-top: 10px; gap: 6px; } .table.responsive td.actions::before { display: none; }
  .table.responsive td[data-label=""]::before { display: none; }
  .modal-back { align-items: flex-end; padding: 0; } .modal { border-radius: 18px 18px 0 0; max-height: 94vh; max-width: 100% !important; }
  #toasts { left: 12px; right: 12px; top: 12px; max-width: none; }
  .att-row .who { flex-basis: 100%; } .seg { width: 100%; } .seg button { flex: 1; }
  .page-head .row { width: 100%; } .stat .val { font-size: 24px; } .kv { grid-template-columns: 110px 1fr; }
}
@media (prefers-reduced-motion: reduce) { * { animation: none !important; transition: none !important; } }
@media print { .sidebar, .topbar, .bottom-nav, .btn { display: none !important; } .main { margin: 0; } }
</style>
</head>
<body>
  <div id="app"><div style="min-height:100vh;display:grid;place-items:center;color:#64748b;font-family:sans-serif">Loading portal&hellip;</div></div>
  <div id="modal-root"></div>
  <div id="toasts" role="status" aria-live="polite"></div>
  <noscript>This portal needs JavaScript. Please enable it in your browser.</noscript>
  <script>
/* =====================================================================
   Js_Core — shared helpers + UI component library + API client.
   Everything is attached to window.App. No framework, no build step.
   RULE: every piece of user-supplied text MUST go through esc() before
   it is put into HTML.
   ===================================================================== */
(function () {
  'use strict';
  var App = window.App = { state: { token: null, user: null, info: {}, route: '', params: {}, unread: 0, cache: {} }, pages: {} };
  var ESC = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
  function esc(s) { return String(s === null || s === undefined ? '' : s).replace(/[&<>"']/g, function (c) { return ESC[c]; }); }
  function $(sel, el) { return (el || document).querySelector(sel); }
  function $$(sel, el) { return Array.prototype.slice.call((el || document).querySelectorAll(sel)); }
  function debounce(fn, ms) { var t; return function () { var a = arguments, s = this; clearTimeout(t); t = setTimeout(function () { fn.apply(s, a); }, ms); }; }
  App.esc = esc; App.$ = $; App.$$ = $$; App.debounce = debounce;

  /* ------------------------------------------------------------ storage */
  var mem = {};
  App.store = {
    get: function (k) { try { return window.localStorage.getItem(k); } catch (e) { return mem[k] || null; } },
    set: function (k, v) { try { window.localStorage.setItem(k, v); } catch (e) { mem[k] = v; } },
    remove: function (k) { try { window.localStorage.removeItem(k); } catch (e) { delete mem[k]; } }
  };

  /* ------------------------------------------------------------ formats */
  var MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
  var fmt = App.fmt = {
    today: function () { var d = new Date(); return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0'); },
    month: function () { return fmt.today().substr(0, 7); },
    date: function (s) {
      if (!s) return '\u2014';
      var m = /^(\d{4})-(\d{2})-(\d{2})/.exec(String(s));
      return m ? (+m[3]) + ' ' + MONTHS[+m[2] - 1] + ' ' + m[1] : esc(s);
    },
    dateTime: function (s) {
      var m = /^(\d{4}-\d{2}-\d{2}) (\d{2}:\d{2})/.exec(String(s || ''));
      return m ? fmt.date(m[1]) + ', ' + m[2] : fmt.date(s);
    },
    money: function (n) { return '\u20B9' + Number(n || 0).toLocaleString('en-IN', { maximumFractionDigits: 2 }); },
    num: function (n) { return Number(n || 0).toLocaleString('en-IN'); },
    monthLabel: function (ym) { var m = /^(\d{4})-(\d{2})$/.exec(ym || ''); return m ? MONTHS[+m[2] - 1] + ' ' + m[1] : ''; },
    days: ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'],
    due: function (a) {
      if (a.daysLeft === null || a.daysLeft === undefined) return '';
      if (a.daysLeft < 0) return 'Overdue by ' + (-a.daysLeft) + ' day' + (a.daysLeft === -1 ? '' : 's');
      if (a.daysLeft === 0) return 'Due today';
      if (a.daysLeft === 1) return 'Due tomorrow';
      return 'Due in ' + a.daysLeft + ' days';
    }
  };

  /* -------------------------------------------------------------- icons */
  var P = {
    home: '<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>',
    grid: '<rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>',
    users: '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
    user: '<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>',
    'user-check': '<path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><polyline points="17 11 19 13 23 9"/>',
    briefcase: '<rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>',
    book: '<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>',
    calendar: '<rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>',
    clipboard: '<path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/>',
    file: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>',
    folder: '<path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>',
    bell: '<path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/>',
    settings: '<line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/><line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/><line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/><line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/>',
    'credit-card': '<rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/>',
    award: '<circle cx="12" cy="8" r="7"/><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/>',
    clock: '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>',
    check: '<polyline points="20 6 9 17 4 12"/>',
    'check-circle': '<path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>',
    x: '<line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>',
    plus: '<line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>',
    edit: '<path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4z"/>',
    trash: '<polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/>',
    search: '<circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>',
    download: '<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>',
    upload: '<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/>',
    menu: '<line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/>',
    logout: '<path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/>',
    'chevron-right': '<polyline points="9 18 15 12 9 6"/>', 'chevron-left': '<polyline points="15 18 9 12 15 6"/>',
    alert: '<circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>',
    info: '<circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/>',
    eye: '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>',
    'eye-off': '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/>',
    layers: '<polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/>',
    lock: '<rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>',
    refresh: '<polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/>',
    rupee: '<path d="M6 3h12"/><path d="M6 8h12"/><path d="M6 13l8.5 8"/><path d="M6 13h3a4.5 4.5 0 0 0 0-10"/>',
    receipt: '<path d="M4 2v20l3-2 3 2 3-2 3 2 3-2 1 1V2l-1 1-3-1-3 2-3-2-3 2z"/><line x1="8" y1="8" x2="16" y2="8"/><line x1="8" y1="12" x2="16" y2="12"/>',
    send: '<line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/>',
    mail: '<path d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z"/><polyline points="22 6 12 13 2 6"/>',
    key: '<path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.78 7.78 5.5 5.5 0 0 1 7.78-7.78zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/>',
    graduation: '<path d="M22 10L12 5 2 10l10 5 10-5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/>'
  };
  App.icon = function (name, cls) {
    return '<svg class="icon' + (cls ? ' ' + cls : '') + '" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + (P[name] || P.info) + '</svg>';
  };
  var icon = App.icon;

  /* ---------------------------------------------------------------- api */
  function ApiError(message, code) { this.message = message; this.code = code || 'SERVER'; }
  ApiError.prototype = Object.create(Error.prototype);
  App.api = function (action, payload) {
    return new Promise(function (resolve, reject) {
      if (!window.google || !google.script || !google.script.run) { reject(new ApiError('Cannot reach the server.', 'NET')); return; }
      google.script.run
        .withSuccessHandler(function (res) {
          if (res && res.ok) { resolve(res.data); return; }
          var err = new ApiError((res && res.error) || 'Something went wrong. Please try again.', (res && res.code) || 'SERVER');
          if (err.code === 'AUTH' && App.sessionExpired) App.sessionExpired();
          reject(err);
        })
        .withFailureHandler(function () { reject(new ApiError('Could not reach the server. Please check your internet connection and try again.', 'NET')); })
        .api(action, App.state.token, payload || {});
    });
  };
  /** Shows the error as a toast (unless the session expired, which already redirects). */
  App.fail = function (e) { if (e && e.code === 'AUTH') return; ui.toast((e && e.message) || 'Something went wrong. Please try again.', 'error'); };

  /* ----------------------------------------------------------------- ui */
  var ui = App.ui = {};

  ui.toast = function (msg, type) {
    var root = $('#toasts'), el = document.createElement('div');
    el.className = 'toast ' + (type || '');
    el.innerHTML = icon(type === 'error' ? 'alert' : (type === 'success' ? 'check-circle' : 'info')) + '<div>' + esc(msg) + '</div>';
    root.appendChild(el);
    setTimeout(function () { el.remove(); }, type === 'error' ? 6500 : 4200);
  };

  ui.badge = function (text, tone) { return '<span class="badge ' + (tone || '') + '">' + esc(text) + '</span>'; };
  var STATUS_TONE = { ACTIVE: 'success', PENDING: 'warning', INACTIVE: '', REJECTED: 'error', PAID: 'success', PARTIAL: 'warning', PUBLISHED: 'success', ARCHIVED: '', PRESENT: 'success', ABSENT: 'error' };
  ui.status = function (s) { return ui.badge(String(s).charAt(0) + String(s).slice(1).toLowerCase(), STATUS_TONE[s]); };
  ui.feeStatus = function (s) { return ui.badge(s === 'PENDING' ? 'Unpaid' : String(s).charAt(0) + String(s).slice(1).toLowerCase(), s === 'PAID' ? 'success' : (s === 'PARTIAL' ? 'warning' : 'error')); };
  ui.grade = function (g) { var t = g === 'F' ? 'error' : (g === 'D' || g === 'C' ? 'warning' : 'success'); return ui.badge(g, t); };

  ui.initials = function (name) {
    var p = String(name || '?').replace(/\(.*?\)/g, '').trim().split(/\s+/);
    return esc((p[0].charAt(0) + (p.length > 1 ? p[p.length - 1].charAt(0) : '')).toUpperCase());
  };
  ui.avatar = function (name, big) { return '<span class="avatar' + (big ? ' lg' : '') + '" aria-hidden="true">' + ui.initials(name) + '</span>'; };

  ui.empty = function (o) {
    return '<div class="empty"><div class="ico">' + icon(o.icon || 'folder') + '</div><h3>' + esc(o.title || 'Nothing here yet') + '</h3>' +
      (o.text ? '<p class="small">' + esc(o.text) + '</p>' : '') + (o.action ? '<div style="margin-top:14px">' + o.action + '</div>' : '') + '</div>';
  };
  ui.skeleton = function (rows) {
    var h = '<div class="stack" aria-busy="true" aria-label="Loading">';
    for (var i = 0; i < (rows || 4); i++) h += '<div class="skeleton" style="height:' + (i === 0 ? 22 : 46) + 'px;width:' + (i === 0 ? 40 : 100) + '%"></div>';
    return h + '</div>';
  };
  ui.pageSkeleton = function () {
    return '<div class="grid c4" style="margin-bottom:16px">' + [1, 2, 3, 4].map(function () { return '<div class="skeleton" style="height:88px"></div>'; }).join('') + '</div>' +
      '<div class="grid c2">' + [1, 2].map(function () { return '<div class="skeleton" style="height:260px"></div>'; }).join('') + '</div>';
  };
  ui.pageHead = function (title, sub, actions) {
    return '<div class="page-head"><div><h1>' + esc(title) + '</h1>' + (sub ? '<p>' + esc(sub) + '</p>' : '') + '</div>' + (actions ? '<div class="row">' + actions + '</div>' : '') + '</div>';
  };
  ui.stat = function (ic, value, label, tone) {
    return '<div class="card stat"><div class="ico ' + (tone || '') + '">' + icon(ic) + '</div><div><div class="val">' + value + '</div><div class="lbl">' + esc(label) + '</div></div></div>';
  };
  ui.donut = function (pct, label, threshold) {
    var r = 52, c = 2 * Math.PI * r, p = Math.max(0, Math.min(100, pct || 0)), off = c * (1 - p / 100);
    var color = (threshold && p < threshold) ? '#d97706' : '#15803d';
    return '<div class="donut" role="img" aria-label="' + esc(label || 'Attendance') + ' ' + p + ' percent"><svg viewBox="0 0 120 120" width="132" height="132"><circle cx="60" cy="60" r="' + r + '" fill="none" stroke="#e2e8f0" stroke-width="12"/>' +
      '<circle cx="60" cy="60" r="' + r + '" fill="none" stroke="' + color + '" stroke-width="12" stroke-linecap="round" stroke-dasharray="' + c.toFixed(1) + '" stroke-dashoffset="' + off.toFixed(1) + '" transform="rotate(-90 60 60)"/></svg>' +
      '<div class="c"><div>' + p + '%<small>' + esc(label || 'attendance') + '</small></div></div></div>';
  };
  ui.progress = function (pct, tone) { return '<div class="progress ' + (tone || '') + '" role="progressbar" aria-valuenow="' + Math.round(pct) + '" aria-valuemin="0" aria-valuemax="100"><span style="width:' + Math.max(0, Math.min(100, pct)) + '%"></span></div>'; };

  /* ------------------------------------------------------------- modals */
  ui.modal = function (o) {
    var root = $('#modal-root'), back = document.createElement('div'), prev = document.activeElement;
    back.className = 'modal-back';
    back.innerHTML = '<div class="modal ' + (o.size || '') + '" role="dialog" aria-modal="true" aria-label="' + esc(o.title) + '">' +
      '<div class="modal-head"><h2>' + esc(o.title) + '</h2><button type="button" class="btn ghost icon-only" data-close aria-label="Close">' + icon('x') + '</button></div>' +
      '<div class="modal-body">' + (o.body || '') + '</div>' + (o.footer ? '<div class="modal-foot">' + o.footer + '</div>' : '') + '</div>';
    root.appendChild(back);
    var h = { el: back, body: $('.modal-body', back), onClose: o.onClose };
    h.close = function () {
      if (!back.parentNode) return;
      document.removeEventListener('keydown', onKey, true);
      back.remove();
      if (prev && prev.focus) { try { prev.focus(); } catch (e) { /* ignore */ } }
      if (h.onClose) h.onClose();
    };
    function onKey(e) {
      if (e.key === 'Escape') { if (root.lastElementChild === back) { e.stopPropagation(); h.close(); } return; }
      if (e.key === 'Tab' && root.lastElementChild === back) {
        var f = $$('button,[href],input,select,textarea,[tabindex]:not([tabindex="-1"])', back).filter(function (x) { return !x.disabled && x.offsetParent !== null; });
        if (!f.length) return;
        var first = f[0], last = f[f.length - 1];
        if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
      }
    }
    document.addEventListener('keydown', onKey, true);
    back.addEventListener('mousedown', function (e) { if (e.target === back) h.close(); });
    back.addEventListener('click', function (e) { if (e.target.closest('[data-close]')) h.close(); });
    setTimeout(function () { var f = $('input:not([type=hidden]),select,textarea', back); (f || $('.modal', back)).focus(); }, 30);
    return h;
  };

  ui.confirm = function (o) {
    return new Promise(function (resolve) {
      var done = false;
      var m = ui.modal({
        title: o.title || 'Are you sure?', size: 'sm', body: '<p>' + esc(o.message) + '</p>',
        footer: '<button type="button" class="btn secondary" data-close>Cancel</button><button type="button" class="btn ' + (o.danger ? 'danger' : '') + '" data-ok>' + esc(o.confirmText || 'Confirm') + '</button>',
        onClose: function () { if (!done) resolve(false); }
      });
      $('[data-ok]', m.el).addEventListener('click', function () { done = true; m.close(); resolve(true); });
    });
  };

  /** Puts a spinner on a button until the promise settles. */
  ui.busy = function (btn, promise) {
    var html = btn ? btn.innerHTML : '';
    if (btn) { btn.classList.add('loading'); btn.setAttribute('aria-busy', 'true'); btn.innerHTML = '<span class="spinner"></span> ' + html.replace(/<svg[\s\S]*?<\/svg>/g, ''); }
    var end = function () { if (btn && btn.isConnected !== false) { btn.classList.remove('loading'); btn.removeAttribute('aria-busy'); btn.innerHTML = html; } };
    return promise.then(function (r) { end(); return r; }, function (e) { end(); throw e; });
  };

  /* -------------------------------------------------------------- forms */
  ui.opts = function (list, value, placeholder) {
    var h = placeholder !== undefined ? '<option value="">' + esc(placeholder) + '</option>' : '';
    list.forEach(function (o) {
      if (typeof o === 'string') o = { value: o, label: o };
      h += '<option value="' + esc(o.value) + '"' + (String(o.value) === String(value) ? ' selected' : '') + '>' + esc(o.label) + '</option>';
    });
    return h;
  };
  ui.field = function (f) {
    var id = f.id || ('f-' + f.name), req = f.required ? ' required' : '', v = f.value === undefined || f.value === null ? '' : f.value, h = '';
    var attrs = (f.attrs || '') + (f.placeholder ? ' placeholder="' + esc(f.placeholder) + '"' : '') + (f.autocomplete ? ' autocomplete="' + f.autocomplete + '"' : '');
    if (f.type === 'select') h = '<select class="select" id="' + id + '" name="' + f.name + '"' + req + ' ' + attrs + '>' + ui.opts(f.options || [], v, f.blank) + '</select>';
    else if (f.type === 'textarea') h = '<textarea class="textarea" id="' + id + '" name="' + f.name + '"' + req + ' ' + attrs + ' rows="' + (f.rows || 3) + '">' + esc(v) + '</textarea>';
    else if (f.type === 'checks') {
      h = '<div class="checks" role="group" aria-label="' + esc(f.label) + '">' + ((f.options || []).map(function (o) {
        if (typeof o === 'string') o = { value: o, label: o };
        var on = (Array.isArray(v) ? v : []).indexOf(o.value) >= 0;
        return '<label class="check"><input type="checkbox" data-group="' + f.name + '" value="' + esc(o.value) + '"' + (on ? ' checked' : '') + '> ' + esc(o.label) + '</label>';
      }).join('') || '<span class="help">' + esc(f.emptyText || 'Nothing to choose from.') + '</span>') + '</div>';
      return '<div class="field ' + (f.full ? 'full' : '') + '"><span class="lbl">' + esc(f.label) + '</span>' + h + (f.help ? '<span class="help">' + esc(f.help) + '</span>' : '') + '</div>';
    } else if (f.type === 'file') {
      h = '<div class="filebox"><input type="file" id="' + id + '" name="' + f.name + '" ' + (f.accept ? 'accept="' + f.accept + '"' : '') + req + '></div>';
    } else if (f.type === 'password') {
      h = '<div class="pw-wrap"><input class="input" id="' + id + '" name="' + f.name + '" type="password"' + req + ' ' + attrs + ' minlength="' + (f.minlength || 8) + '"><button type="button" class="btn ghost sm icon-only" data-pw aria-label="Show password">' + icon('eye') + '</button></div>';
    } else h = '<input class="input" id="' + id + '" name="' + f.name + '" type="' + (f.type || 'text') + '" value="' + esc(v) + '"' + req + ' ' + attrs + (f.max ? ' max="' + f.max + '"' : '') + (f.min !== undefined ? ' min="' + f.min + '"' : '') + (f.step ? ' step="' + f.step + '"' : '') + '>';
    return '<div class="field ' + (f.full ? 'full' : '') + '"><label for="' + id + '">' + esc(f.label) + (f.required ? ' <span class="req" aria-hidden="true">*</span>' : '') + '</label>' + h + (f.help ? '<span class="help">' + esc(f.help) + '</span>' : '') + '</div>';
  };
  ui.formData = function (form) {
    var out = {};
    $$('input,select,textarea', form).forEach(function (el) {
      if (!el.name && !el.dataset.group) return;
      if (el.type === 'checkbox' && el.dataset.group) { out[el.dataset.group] = out[el.dataset.group] || []; if (el.checked) out[el.dataset.group].push(el.value); return; }
      if (el.type === 'file') return;
      if (el.type === 'checkbox') { out[el.name] = el.checked; return; }
      out[el.name] = el.value;
    });
    return out;
  };
  ui.readFile = function (input, kind) {
    return new Promise(function (resolve, reject) {
      var f = input && input.files && input.files[0];
      if (!f) { resolve(null); return; }
      var allowed = { assignment: ['pdf'], material: ['pdf', 'doc', 'docx', 'ppt', 'pptx', 'xls', 'xlsx', 'jpg', 'jpeg', 'png'], logo: ['png', 'jpg', 'jpeg'] }[kind] || [];
      var ext = (f.name.split('.').pop() || '').toLowerCase();
      if (allowed.indexOf(ext) < 0) { reject(new ApiError('Allowed file types: ' + allowed.join(', ').toUpperCase() + '.', 'VALIDATION')); return; }
      var max = kind === 'logo' ? 300 * 1024 : 10 * 1024 * 1024;
      if (f.size > max) { reject(new ApiError('The file is too large (maximum ' + (kind === 'logo' ? '300 KB' : '10 MB') + ').', 'VALIDATION')); return; }
      var r = new FileReader();
      r.onload = function () { resolve({ name: f.name, data: String(r.result).split(',')[1] || '' }); };
      r.onerror = function () { reject(new ApiError('The file could not be read. Please try again.', 'VALIDATION')); };
      r.readAsDataURL(f);
    });
  };
  /** Opens a modal with a form. onSubmit(data, form, handle) -> Promise. Resolve = close, return false = keep open. */
  ui.formModal = function (o) {
    var fields = o.fields.map(ui.field).join('');
    var m = ui.modal({
      title: o.title, size: o.size,
      body: (o.intro ? '<p class="muted small" style="margin-bottom:14px">' + o.intro + '</p>' : '') + '<div class="form-error" aria-live="assertive"></div><form id="modal-form" class="form-grid">' + fields + '</form>' + (o.after || ''),
      footer: '<button type="button" class="btn secondary" data-close>Cancel</button><button type="submit" form="modal-form" class="btn ' + (o.danger ? 'danger' : '') + '">' + esc(o.submitText || 'Save') + '</button>'
    });
    var form = $('#modal-form', m.el), errBox = $('.form-error', m.el), btn = $('button[type=submit]', m.el);
    if (o.onOpen) o.onOpen(m, form);
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      errBox.innerHTML = '';
      var p;
      try { p = Promise.resolve(o.onSubmit(ui.formData(form), form, m)); } catch (x) { p = Promise.reject(x); }
      ui.busy(btn, p).then(function (r) { if (r !== false) m.close(); }).catch(function (err) {
        if (err && err.code === 'AUTH') return;
        errBox.innerHTML = '<div class="alert error" role="alert" style="margin-bottom:14px">' + icon('alert') + '<div>' + esc(err && err.message ? err.message : 'Something went wrong. Please try again.') + '</div></div>';
        var b = $('.modal-body', m.el); if (b) b.scrollTop = 0;
      });
    });
    return m;
  };
  /** Small dialog that shows a generated password / credentials once. */
  ui.secretDialog = function (title, lines, note) {
    var body = '<div class="receipt-box"><dl class="kv">' + lines.map(function (l) { return '<dt>' + esc(l[0]) + '</dt><dd style="font-family:monospace;font-size:16px">' + esc(l[1]) + '</dd>'; }).join('') + '</dl></div>' +
      '<p class="small muted" style="margin-top:12px">' + esc(note || 'Please note this down now. It will not be shown again.') + '</p>';
    ui.modal({ title: title, size: 'sm', body: body, footer: '<button type="button" class="btn" data-close>Done</button>' });
  };

  /* ------------------------------------------------------ tables/lists */
  ui.table = function (cols, rows) {
    var h = '<div class="table-wrap"><table class="table responsive"><thead><tr>' + cols.map(function (c) { return '<th scope="col"' + (c.cls ? ' class="' + c.cls + '"' : '') + '>' + esc(c.label || '') + '</th>'; }).join('') + '</tr></thead><tbody>';
    rows.forEach(function (r, i) {
      h += '<tr>' + cols.map(function (c) {
        return '<td' + (c.actions ? ' class="actions"' : (c.cls ? ' class="' + c.cls + '"' : '')) + ' data-label="' + esc(c.actions ? '' : (c.label || '')) + '">' + c.render(r, i) + '</td>';
      }).join('') + '</tr>';
    });
    return h + '</tbody></table></div>';
  };
  ui.act = function (act, i, ic, label, cls) {
    return '<button type="button" class="btn sm ' + (cls || 'secondary') + '" data-act="' + act + '" data-i="' + i + '" title="' + esc(label) + '" aria-label="' + esc(label) + '">' + icon(ic) + '<span class="act-label">' + esc(label) + '</span></button> ';
  };

  /**
   * Server-side paged list with filters, search and pagination.
   * o = { root, fetch(params)->Promise, columns, filters:[{key,type,placeholder,options}], empty:{}, onAction(act,row,ctrl), pageSize, extra(html)->toolbar html }
   */
  ui.dataList = function (o) {
    var st = { page: 1, values: {}, rows: [], data: null };
    (o.filters || []).forEach(function (f) { st.values[f.key] = f.value || ''; });
    var root = o.root;
    root.innerHTML = '<div class="toolbar" data-tb></div><div data-body></div><div class="pager" data-pager></div>';
    var tb = $('[data-tb]', root), body = $('[data-body]', root), pager = $('[data-pager]', root);
    tb.innerHTML = (o.filters || []).map(function (f) {
      if (f.type === 'search') return '<div class="search">' + icon('search') + '<input class="input" type="search" data-f="' + f.key + '" placeholder="' + esc(f.placeholder || 'Search') + '" aria-label="' + esc(f.placeholder || 'Search') + '" value="' + esc(f.value || '') + '"></div>';
      if (f.type === 'date') return '<label class="row nowrapflex small muted" style="gap:6px">' + esc(f.placeholder || f.key) + '<input class="input" style="width:auto" type="date" data-f="' + f.key + '" value="' + esc(f.value || '') + '"></label>';
      return '<select class="select" data-f="' + f.key + '" aria-label="' + esc(f.placeholder || f.key) + '">' + ui.opts(f.options || [], f.value || '', f.placeholder || 'All') + '</select>';
    }).join('') + (o.toolbarExtra || '');
    var ctrl = { st: st, root: root };
    function load() {
      body.innerHTML = ui.skeleton(5);
      var params = { page: st.page, pageSize: o.pageSize || 25 };
      Object.keys(st.values).forEach(function (k) { params[k] = st.values[k]; });
      if (o.params) Object.assign(params, o.params());
      return o.fetch(params).then(function (d) {
        st.data = d; st.rows = d.items || [];
        if (!st.rows.length) {
          body.innerHTML = '<div class="card">' + ui.empty(o.empty || { title: 'No records found', text: 'Try changing the filters.' }) + '</div>';
          pager.innerHTML = '';
        } else {
          body.innerHTML = ui.table(o.columns, st.rows);
          var from = (d.page - 1) * d.pageSize + 1, to = from + st.rows.length - 1;
          pager.innerHTML = '<span>Showing ' + from + '\u2013' + to + ' of ' + d.total + '</span><span class="row">' +
            '<button type="button" class="btn secondary sm" data-page="' + (d.page - 1) + '"' + (d.page <= 1 ? ' disabled' : '') + '>' + icon('chevron-left') + ' Previous</button>' +
            '<span>Page ' + d.page + ' of ' + d.pages + '</span>' +
            '<button type="button" class="btn secondary sm" data-page="' + (d.page + 1) + '"' + (d.page >= d.pages ? ' disabled' : '') + '>Next ' + icon('chevron-right') + '</button></span>';
        }
        if (o.onLoad) o.onLoad(d, ctrl);
      }).catch(function (e) {
        body.innerHTML = '<div class="card">' + ui.empty({ icon: 'alert', title: 'Could not load this list', text: e.message, action: '<button type="button" class="btn secondary" data-retry>Try again</button>' }) + '</div>';
        pager.innerHTML = '';
        App.fail(e);
      });
    }
    ctrl.reload = load;
    tb.addEventListener('input', debounce(function (e) { var f = e.target.dataset.f; if (f && e.target.type === 'search') { st.values[f] = e.target.value; st.page = 1; load(); } }, 350));
    tb.addEventListener('change', function (e) { var f = e.target.dataset.f; if (f && (e.target.tagName === 'SELECT' || e.target.type === 'date')) { st.values[f] = e.target.value; st.page = 1; load(); } });
    root.addEventListener('click', function (e) {
      var pg = e.target.closest('[data-page]'), a = e.target.closest('[data-act]'), rt = e.target.closest('[data-retry]');
      if (pg && !pg.disabled) { st.page = +pg.dataset.page; load(); }
      else if (rt) load();
      else if (a && o.onAction) o.onAction(a.dataset.act, st.rows[+a.dataset.i], ctrl, a);
    });
    load();
    return ctrl;
  };

  /** Type-to-search student picker. onPick(student) is called with the chosen student. */
  ui.studentPicker = function (box, onPick, initial) {
    var chosen = initial || null;
    function paint() {
      if (chosen) {
        box.innerHTML = '<div class="chosen"><div><b>' + esc(chosen.name) + '</b><div class="xs muted">' + esc(chosen.studentId) + ' \u00B7 Class ' + esc(chosen.class) + '</div></div><button type="button" class="btn ghost sm" data-change>Change</button></div>';
        $('[data-change]', box).onclick = function () { chosen = null; onPick(null); paint(); };
      } else {
        box.innerHTML = '<input class="input" type="search" placeholder="Search student by name or ID" aria-label="Search student" autocomplete="off"><div data-res></div>';
        var inp = $('input', box), res = $('[data-res]', box);
        inp.addEventListener('input', debounce(function () {
          var q = inp.value.trim();
          if (q.length < 2) { res.innerHTML = ''; return; }
          res.innerHTML = '<div class="small muted" style="padding:8px">Searching\u2026</div>';
          App.api('students.list', { q: q, status: 'ACTIVE', pageSize: 8 }).then(function (d) {
            res.innerHTML = d.items.length ? '<div class="picker-list">' + d.items.map(function (s, i) { return '<button type="button" data-i="' + i + '"><span>' + esc(s.name) + '</span><span class="muted">' + esc(s.studentId) + ' \u00B7 Cl ' + esc(s.class) + '</span></button>'; }).join('') + '</div>' : '<div class="small muted" style="padding:8px">No matching students.</div>';
            res.onclick = function (e) { var b = e.target.closest('button[data-i]'); if (b) { chosen = d.items[+b.dataset.i]; onPick(chosen); paint(); } };
          }).catch(App.fail);
        }, 300));
      }
    }
    paint();
    return { get: function () { return chosen; } };
  };

  /* ------------------------------------------------------ file helpers */
  App.saveFile = function (res, opts) {
    var bin = atob(res.data), arr = new Uint8Array(bin.length);
    for (var i = 0; i < bin.length; i++) arr[i] = bin.charCodeAt(i);
    var url = URL.createObjectURL(new Blob([arr], { type: res.mime }));
    if (opts && opts.view) { var w = window.open(url, '_blank'); if (w) { setTimeout(function () { URL.revokeObjectURL(url); }, 300000); return; } }
    var a = document.createElement('a');
    a.href = url; a.download = res.name || 'file'; document.body.appendChild(a); a.click(); a.remove();
    // Some browsers / embedded frames block automatic downloads, so also offer real links the user can tap.
    var el = document.createElement('div');
    el.className = 'toast success';
    el.innerHTML = icon('check-circle') + '<div><b>' + esc(res.name || 'File') + '</b> is ready.<br><a href="' + url + '" download="' + esc(res.name || 'file') + '" style="color:#fff">Download</a> &middot; <a href="' + url + '" target="_blank" rel="noopener" style="color:#fff">Open in new tab</a></div>';
    $('#toasts').appendChild(el);
    setTimeout(function () { el.remove(); }, 15000);
    setTimeout(function () { URL.revokeObjectURL(url); }, 300000);
  };
  App.download = function (btn, action, payload, opts) {
    return ui.busy(btn, App.api(action, payload).then(function (res) { App.saveFile(res, opts); })).catch(App.fail);
  };

  /* ------------------------------------------------- shared data cache */
  App.batches = function (force) {
    if (!force && App.state.cache.batches) return Promise.resolve(App.state.cache.batches);
    return App.api('batches.list', {}).then(function (d) { App.state.cache.batches = d.items; return d.items; });
  };
  App.batchOptions = function (items, onlyActive) {
    return items.filter(function (b) { return !onlyActive || b.status === 'ACTIVE'; }).map(function (b) { return { value: b.batch, label: b.batch + ' \u2014 ' + b.subject }; });
  };

  /* --------------------------------------------- global click delegation */
  document.addEventListener('click', function (e) {
    var g = e.target.closest('[data-go]');
    if (g && App.go) { e.preventDefault(); App.go(g.dataset.go, g.dataset.param ? JSON.parse(g.dataset.param) : {}); return; }
    var pw = e.target.closest('[data-pw]');
    if (pw) {
      var inp = $('input', pw.parentNode), show = inp.type === 'password';
      inp.type = show ? 'text' : 'password'; pw.innerHTML = icon(show ? 'eye-off' : 'eye'); pw.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
    }
  });
})();
</script>
  <script>
/* Js_Auth — login, registration (student/teacher), logout, change password */
(function () {
  'use strict';
  var App = window.App, $ = App.$, esc = App.esc, icon = App.icon, ui = App.ui;

  App.logoHtml = function (info) {
    if (info && info.logo) return '<img src="' + esc(info.logo) + '" alt="">';
    var p = String((info && info.name) || 'SC').replace(/[^A-Za-z0-9 ]/g, ' ').trim().split(/\s+/);
    return esc((p[0].charAt(0) + (p.length > 1 ? p[p.length - 1].charAt(0) : '')).toUpperCase());
  };

  function heroHtml(info) {
    return '<section class="auth-hero" aria-hidden="false"><div>' +
      '<div class="logo">' + App.logoHtml(info) + '</div>' +
      '<h1>' + esc(info.name || 'Success Coaching Classes') + '</h1>' +
      '<p class="tagline">Attendance, assignments, study material, results and fees \u2014 everything for Classes ' + esc((info.classes || ['8', '9', '10']).join(', ').replace(/, (\d+)$/, ' & $1')) + ', in one place.</p>' +
      '<ul>' + ['Track attendance and results', 'Download assignments and study material', 'View fees and payment receipts'].map(function (t) { return '<li>' + icon('check-circle') + '<span>' + t + '</span></li>'; }).join('') + '</ul></div>' +
      '<div class="small" style="opacity:.8">' + esc(info.address || '') + (info.phone ? '<br>' + esc(info.phone) : '') + '</div></section>';
  }
  function mobileBrand(info) {
    return '<div class="auth-mobile-brand"><div class="logo">' + App.logoHtml(info) + '</div><div><div class="bold" style="text-transform:uppercase">' + esc(info.name) + '</div><div class="small muted">Student &amp; Teacher Portal</div></div></div>';
  }

  App.renderAuth = function (mode, extra) {
    var info = App.state.info || {}, root = $('#app');
    App.state.user = null;
    var form;
    if (mode === 'register') form = registerForm(info, extra || 'student');
    else if (mode === 'done') form = doneCard(extra);
    else if (mode === 'forgot') form = forgotForm(info);
    else if (mode === 'forgotDone') form = forgotDoneCard(extra);
    else form = loginForm(info);
    root.innerHTML = '<div class="auth">' + heroHtml(info) + '<main class="auth-form-wrap"><div class="auth-card">' + mobileBrand(info) + form + '</div></main></div>';
    bind(mode, extra);
  };

  function loginForm(info) {
    return '<h2>Welcome back</h2><p class="muted" style="margin-bottom:22px">Sign in to your account</p>' +
      '<div id="auth-err"></div>' +
      '<form id="login-form" class="stack" novalidate>' +
      '<div class="field"><label for="lg-user">Username / Student ID / Teacher ID</label><input class="input" id="lg-user" name="username" autocomplete="username" autocapitalize="off" spellcheck="false" required></div>' +
      '<div class="field"><label for="lg-pass">Password</label><div class="pw-wrap"><input class="input" id="lg-pass" name="password" type="password" autocomplete="current-password" required><button type="button" class="btn ghost sm icon-only" data-pw aria-label="Show password">' + icon('eye') + '</button></div></div>' +
      '<button class="btn block" type="submit" id="lg-btn">Sign in</button></form>' +
      '<div class="center small" style="margin-top:14px"><a href="#" data-forgot>Forgot your password?</a></div>' +
      ((info.studentRegistration || info.teacherRegistration) ? '<div class="center small muted" style="margin-top:22px">New here? ' +
        (info.studentRegistration ? '<a href="#" data-reg="student">Register as a student</a>' : '') +
        (info.studentRegistration && info.teacherRegistration ? ' \u00B7 ' : '') +
        (info.teacherRegistration ? '<a href="#" data-reg="teacher">Register as a teacher</a>' : '') + '</div>' : '') +
      '';
  }

  function forgotForm(info) {
    return '<h2>Reset student password</h2><p class="muted" style="margin-bottom:22px">Enter your Student ID and the phone number registered with the institute.</p>' +
      '<div id="auth-err"></div>' +
      '<form id="forgot-form" class="stack" novalidate>' +
      ui.field({ name: 'studentId', label: 'Student ID', required: true, autocomplete: 'username', attrs: 'maxlength="30" autocapitalize="characters"' }) +
      ui.field({ name: 'phone', label: 'Registered phone number', type: 'tel', required: true, autocomplete: 'tel', attrs: 'inputmode="numeric" maxlength="14"', help: 'Enter the same 10-digit number used during registration.' }) +
      '<button class="btn block" type="submit" id="fp-btn">Generate temporary password</button></form>' +
      '<p class="center xs muted" style="margin-top:18px">For security, the temporary password is shown only once. Keep it private.</p>' +
      '<div class="center small" style="margin-top:18px"><a href="#" data-login>\u2190 Back to sign in</a></div>';
  }

  function forgotDoneCard(r) {
    return '<div class="center"><div class="empty" style="padding:10px 0 0"><div class="ico" style="background:var(--success-50);color:var(--success)">' + icon('check-circle') + '</div><h2>Password reset</h2></div>' +
      '<p class="muted" style="margin:8px 0 18px">Use this temporary password to sign in. The previous password no longer works.</p>' +
      '<div class="receipt-box" style="text-align:left"><dl class="kv"><dt>Student ID</dt><dd style="font-family:monospace;font-size:18px">' + esc(r.username) + '</dd><dt>Temporary password</dt><dd style="font-family:monospace;font-size:18px;word-break:break-all">' + esc(r.password) + '</dd></dl></div>' +
      '<p class="small muted" style="margin:14px 0 20px">Write it down before continuing. After signing in, use Change password to choose your own password.</p>' +
      '<button class="btn block" data-login type="button">Back to sign in</button></div>';
  }

  function registerForm(info, role) {
    var classes = info.classes || ['8', '9', '10'];
    var roleSwitch = (info.studentRegistration && info.teacherRegistration) ?
      '<div class="role-pick" role="group" aria-label="Register as" style="margin-bottom:16px"><button type="button" data-role="student" aria-pressed="' + (role === 'student') + '">Student</button><button type="button" data-role="teacher" aria-pressed="' + (role === 'teacher') + '">Teacher</button></div>' : '';
    return '<h2>Create your account</h2><p class="muted" style="margin-bottom:16px">Your registration will be checked by the institute before you can log in.</p>' + roleSwitch +
      '<div id="auth-err"></div><form id="reg-form" class="stack" data-role="' + role + '">' +
      ui.field({ name: 'name', label: 'Full name', required: true, autocomplete: 'name', attrs: 'maxlength="80"' }) +
      (role === 'student' ? ui.field({ name: 'class', label: 'Class', type: 'select', required: true, blank: 'Select class', options: classes.map(function (c) { return { value: c, label: 'Class ' + c }; }) })
        : ui.field({ name: 'subject', label: 'Subject you teach', required: true, attrs: 'maxlength="60"' })) +
      ui.field({ name: 'phone', label: 'Phone number', type: 'tel', required: true, autocomplete: 'tel', attrs: 'inputmode="numeric" maxlength="14"', help: '10-digit mobile number' }) +
      ui.field({ name: 'password', label: 'Create a password', type: 'password', required: true, autocomplete: 'new-password', help: 'At least 8 characters with letters and numbers' }) +
      ui.field({ name: 'password2', label: 'Confirm password', type: 'password', required: true, autocomplete: 'new-password' }) +
      '<button class="btn block" type="submit" id="rg-btn">Submit registration</button></form>' +
      '<div class="center small" style="margin-top:18px"><a href="#" data-login>\u2190 Back to sign in</a></div>';
  }

  function doneCard(r) {
    return '<div class="center"><div class="empty" style="padding:10px 0 0"><div class="ico" style="background:var(--success-50);color:var(--success)">' + icon('check-circle') + '</div><h2>Registration received</h2></div>' +
      '<p class="muted" style="margin:8px 0 18px">Please wait for the institute to approve your account. You can then sign in with:</p>' +
      '<div class="receipt-box" style="text-align:left"><dl class="kv"><dt>Your ID / Username</dt><dd style="font-family:monospace;font-size:18px">' + esc(r.id) + '</dd><dt>Password</dt><dd>The one you just chose</dd></dl></div>' +
      '<p class="small muted" style="margin:14px 0 20px">Write your ID down \u2014 you will need it to sign in.</p>' +
      '<button class="btn block" data-login type="button">Back to sign in</button></div>';
  }

  function showErr(msg) {
    var box = $('#auth-err');
    if (box) box.innerHTML = '<div class="alert error" role="alert" style="margin-bottom:14px">' + icon('alert') + '<div>' + esc(msg) + '</div></div>';
  }

  function bind(mode, extra) {
    var root = $('#app');
    root.onclick = function (e) {
      var r = e.target.closest('[data-reg]'), l = e.target.closest('[data-login]'), f = e.target.closest('[data-forgot]'), ro = e.target.closest('[data-role]');
      if (r) { e.preventDefault(); App.renderAuth('register', r.dataset.reg); }
      else if (l) { e.preventDefault(); App.renderAuth('login'); }
      else if (f) { e.preventDefault(); App.renderAuth('forgot'); }
      else if (ro && ro.tagName === 'BUTTON') { App.renderAuth('register', ro.dataset.role); }
    };
    var lf = $('#login-form');
    if (lf) {
      $('#lg-user').focus();
      lf.addEventListener('submit', function (e) {
        e.preventDefault();
        var u = $('#lg-user').value.trim(), p = $('#lg-pass').value;
        if (!u || !p) { showErr('Please enter your username and password.'); return; }
        $('#auth-err').innerHTML = '';
        ui.busy($('#lg-btn'), App.api('auth.login', { username: u, password: p })).then(function (d) { App.startSession(d); })
          .catch(function (err) { showErr(err.message); });
      });
    }
    var ff = $('#forgot-form');
    if (ff) {
      $('#fp-btn').focus();
      ff.addEventListener('submit', function (e) {
        e.preventDefault();
        var d = ui.formData(ff);
        if (!d.studentId || !d.phone) { showErr('Please enter your Student ID and registered phone number.'); return; }
        $('#auth-err').innerHTML = '';
        ui.busy($('#fp-btn'), App.api('auth.forgotStudentPassword', d))
          .then(function (res) { App.renderAuth('forgotDone', res); })
          .catch(function (err) { showErr(err.message); });
      });
    }

    var rf = $('#reg-form');
    if (rf) {
      rf.addEventListener('submit', function (e) {
        e.preventDefault();
        var d = ui.formData(rf), role = rf.dataset.role;
        if (d.password !== d.password2) { showErr('The two passwords do not match.'); return; }
        $('#auth-err').innerHTML = '';
        delete d.password2;
        ui.busy($('#rg-btn'), App.api(role === 'student' ? 'auth.registerStudent' : 'auth.registerTeacher', d))
          .then(function (res) { App.renderAuth('done', res); })
          .catch(function (err) { showErr(err.message); });
      });
    }
  }

  App.logout = function () {
    var done = function () { App.store.remove('scc_token'); App.state.token = null; App.state.cache = {}; App.renderAuth('login'); };
    App.api('auth.logout').then(done, done);
  };

  App.sessionExpired = function () {
    if (!App.state.token) return;
    App.store.remove('scc_token'); App.state.token = null; App.state.cache = {};
    App.renderAuth('login');
    ui.toast('Your session has expired. Please sign in again.', 'error');
  };

  App.changePasswordDialog = function () {
    ui.formModal({
      title: 'Change password', submitText: 'Change password', size: 'sm',
      fields: [
        { name: 'oldPassword', label: 'Current password', type: 'password', required: true, full: true, autocomplete: 'current-password' },
        { name: 'newPassword', label: 'New password', type: 'password', required: true, full: true, autocomplete: 'new-password', help: 'At least 8 characters with letters and numbers' },
        { name: 'confirm', label: 'Confirm new password', type: 'password', required: true, full: true, autocomplete: 'new-password' }
      ],
      onSubmit: function (d) {
        if (d.newPassword !== d.confirm) return Promise.reject({ message: 'The new passwords do not match.' });
        return App.api('auth.changePassword', { oldPassword: d.oldPassword, newPassword: d.newPassword }).then(function () { ui.toast('Password changed successfully.', 'success'); });
      }
    });
  };
})();
</script>
  <script>
/* Js_Dashboard — Admin / Teacher / Student dashboards + shared list-item renderers */
(function () {
  'use strict';
  var App = window.App, $ = App.$, esc = App.esc, icon = App.icon, ui = App.ui, fmt = App.fmt;
  var parts = App.parts = {};

  function greeting() { var h = new Date().getHours(); return h < 12 ? 'Good morning' : (h < 17 ? 'Good afternoon' : 'Good evening'); }
  function goAttr(route, param) { return 'data-go="' + route + '"' + (param ? ' data-param="' + esc(JSON.stringify(param)) + '"' : ''); }
  function panel(title, route, body, linkLabel) {
    return '<section class="card" aria-label="' + esc(title) + '"><div class="card-head"><h3>' + esc(title) + '</h3>' +
      (route ? '<a href="#" class="small bold" data-go="' + route + '">' + esc(linkLabel || 'View all') + ' ' + icon('chevron-right') + '</a>' : '') + '</div>' + body + '</section>';
  }
  function list(items, render, empty) {
    if (!items || !items.length) return '<div class="empty" style="padding:28px 16px"><p class="small">' + esc(empty || 'Nothing to show yet.') + '</p></div>';
    return '<ul class="list">' + items.map(render).join('') + '</ul>';
  }
  App.panel = panel; App.listOf = list;

  /* ----------------------------------------------------- shared items */
  parts.assignmentItem = function (a, opts) {
    var tone = a.overdue ? 'error' : (a.daysLeft !== null && a.daysLeft <= 2 ? 'warning' : 'info');
    return '<li class="list-item"><div class="avatar" style="background:var(--warning-50);color:var(--warning)">' + icon('file') + '</div><div class="grow"><div class="bold">' + esc(a.title) + '</div>' +
      '<div class="xs muted">' + esc(a.subject) + (opts && opts.showBatch ? ' \u00B7 ' + esc(a.batch) : '') + ' \u00B7 Due ' + fmt.date(a.dueDate) + '</div></div>' + ui.badge(fmt.due(a), tone) + '</li>';
  };
  parts.materialItem = function (m) {
    return '<li class="list-item"><div class="avatar" style="background:var(--secondary-50);color:var(--secondary)">' + icon('book') + '</div><div class="grow"><div class="bold">' + esc(m.title) + '</div>' +
      '<div class="xs muted">' + esc(m.subject) + ' \u00B7 ' + esc(m.batch) + ' \u00B7 ' + fmt.date(m.date) + '</div></div></li>';
  };
  parts.eventItem = function (e) {
    var d = /^(\d{4})-(\d{2})-(\d{2})$/.exec(e.date) || [];
    var tone = { Holiday: 'success', Test: 'error', 'Parent Meeting': 'warning', 'Special Class': 'info' }[e.eventType] || 'primary';
    return '<li class="list-item"><div class="avatar" style="border-radius:12px;flex-direction:column;line-height:1.1;font-size:11px"><b style="font-size:15px">' + (d[3] ? +d[3] : '') + '</b>' + esc(fmt.date(e.date).split(' ')[1] || '') + '</div>' +
      '<div class="grow"><div class="bold">' + esc(e.title) + '</div><div class="xs muted">' + (e.time ? esc(e.time) + ' \u00B7 ' : '') + esc(e.target === 'ALL' ? 'Everyone' : e.target.replace('CLASS_', 'Class ')) + '</div></div>' + ui.badge(e.eventType, tone) + '</li>';
  };
  parts.noteItem = function (n) {
    return '<li class="list-item"><div class="avatar" style="' + (n.unread ? '' : 'background:#eef2f7;color:var(--muted)') + '">' + icon('bell') + '</div><div class="grow"><div class="' + (n.unread ? 'bold' : '') + '">' + esc(n.title) + '</div>' +
      '<div class="xs muted">' + esc(n.message).substr(0, 90) + '</div></div><span class="xs muted nowrap">' + fmt.date(String(n.date).substr(0, 10)) + '</span></li>';
  };
  parts.paymentItem = function (p) {
    return '<li class="list-item"><div class="avatar" style="background:var(--success-50);color:var(--success)">' + icon('rupee') + '</div><div class="grow"><div class="bold">' + esc(p.studentName) + '</div>' +
      '<div class="xs muted">' + esc(p.feeType) + ' \u00B7 ' + fmt.date(p.date) + ' \u00B7 ' + esc(String(p.mode).replace('_', ' ')) + '</div></div><b>' + fmt.money(p.amount) + '</b></li>';
  };

  /* ---------------------------------------------------------- render */
  App.pages.dashboard = {
    render: function (root, params, token) {
      var role = App.state.user.role;
      return App.api('dashboard.get', { fresh: !!(params && params.fresh) }).then(function (d) {
        if (!App.stillHere(token)) return;
        if (role === 'ADMIN') admin(root, d); else if (role === 'TEACHER') teacher(root, d); else student(root, d);
      });
    }
  };

  function head(name, sub, actions) {
    return ui.pageHead(greeting() + ', ' + name, sub, actions);
  }

  /* ------------------------------------------------------------ admin */
  function admin(root, d) {
    var s = d.stats, a = d.attendance;
    App.setApprovals(s.pending);
    var h = head('Admin', 'Here is what is happening at the institute today (' + fmt.date(d.today) + ').',
      '<button type="button" class="btn secondary" ' + goAttr('dashboard', { fresh: true }) + '>' + icon('refresh') + ' Refresh</button><button type="button" class="btn" ' + goAttr('attendance') + '>' + icon('clipboard') + ' Attendance</button>');
    if (s.pending) h += '<div class="alert-strip"><div class="alert warning" ' + goAttr('approvals') + '>' + icon('user-check') + '<div class="grow"><b>' + s.pending + ' registration' + (s.pending === 1 ? '' : 's') + ' waiting for approval</b></div>' + icon('chevron-right') + '</div></div>';
    h += '<div class="grid c4" style="margin-bottom:16px">' +
      ui.stat('users', fmt.num(s.students), 'Active students') + ui.stat('briefcase', fmt.num(s.teachers), 'Active teachers', 'secondary') +
      ui.stat('layers', fmt.num(s.batches), 'Active batches', 'warning') +
      ui.stat('clipboard', a.scheduled ? a.marked + '/' + a.scheduled : '\u2014', a.scheduled ? 'Batches marked today' : 'No classes scheduled today', a.scheduled && a.marked < a.scheduled ? 'warning' : 'success') + '</div>';
    h += '<div class="grid c3" style="margin-bottom:16px">' +
      ui.stat('rupee', fmt.money(s.outstanding), 'Outstanding fees (' + s.studentsWithDues + ' students)', 'error') +
      ui.stat('credit-card', fmt.money(s.collectedThisMonth), 'Collected this month', 'success') +
      ui.stat('check-circle', a.marked ? a.percent + '%' : '\u2014', 'Attendance today (marked batches)', 'secondary') + '</div>';
    h += '<div class="grid c2">' +
      panel('Attendance not marked today', 'attendance', list(d.pendingBatches, function (b) {
        return '<li class="list-item"><div class="grow"><div class="bold">' + esc(b.batch) + ' <span class="muted">\u00B7 ' + esc(b.subject) + '</span></div><div class="xs muted">' + esc(b.teacherName) + (b.time ? ' \u00B7 ' + esc(b.time) : '') + '</div></div>' +
          '<button type="button" class="btn sm" ' + goAttr('attendance', { batch: b.batch }) + '>Mark</button></li>';
      }, 'All scheduled batches are marked. \uD83C\uDF89'), 'Open attendance') +
      panel('Recent payments', 'fees', list(d.recentPayments, parts.paymentItem, 'No payments recorded yet.')) +
      panel('Upcoming events', 'events', list(d.upcomingEvents, parts.eventItem, 'No upcoming events.')) +
      panel('Recent assignments', 'assignments', list(d.recentAssignments, function (a) { return parts.assignmentItem(a, { showBatch: true }); }, 'No assignments yet.')) +
      panel('Recent notifications', 'notifications', list(d.recentNotifications, parts.noteItem, 'No notifications sent yet.')) + '</div>';
    root.innerHTML = h;
  }

  /* ---------------------------------------------------------- teacher */
  function teacher(root, d) {
    var s = d.stats;
    var h = head(App.state.user.name.split(' ')[0], 'Today is ' + fmt.date(d.today) + '.',
      '<button type="button" class="btn" ' + goAttr('attendance') + '>' + icon('clipboard') + ' Take attendance</button><button type="button" class="btn secondary" ' + goAttr('assignments', { create: true }) + '>' + icon('plus') + ' New assignment</button>');
    h += '<div class="grid c4" style="margin-bottom:16px">' +
      ui.stat('layers', s.batches, 'My batches') + ui.stat('users', s.students, 'My students', 'secondary') +
      ui.stat('clock', s.classesToday, 'Classes today', 'warning') + ui.stat('clipboard', s.attendancePending, 'Attendance pending', s.attendancePending ? 'error' : 'success') + '</div>';
    h += '<div class="grid c2">' +
      panel('Today\u2019s classes', 'timetable', list(d.todayClasses, function (c) {
        return '<li class="list-item"><div class="grow"><div class="bold">' + esc(c.batch) + ' <span class="muted">\u00B7 ' + esc(c.subject) + '</span></div><div class="xs muted">' + esc(c.time || 'Time not set') + ' \u00B7 ' + c.students + ' students</div></div>' +
          (c.marked ? ui.badge('Marked', 'success') + ' ' : '') + '<button type="button" class="btn sm ' + (c.marked ? 'secondary' : '') + '" ' + goAttr('attendance', { batch: c.batch }) + '>' + (c.marked ? 'Edit' : 'Take attendance') + '</button></li>';
      }, 'No classes scheduled today. Enjoy your day!'), 'Timetable') +
      panel('Recent assignments', 'assignments', list(d.recentAssignments, function (a) { return parts.assignmentItem(a, { showBatch: true }); }, 'You have not posted any assignments yet.')) +
      panel('Recent study material', 'materials', list(d.recentMaterials, parts.materialItem, 'No study material uploaded yet.')) +
      panel('Recent results entered', 'results', list(d.recentResults, function (r) {
        return '<li class="list-item"><div class="avatar" style="background:var(--success-50);color:var(--success)">' + icon('award') + '</div><div class="grow"><div class="bold">' + esc(r.exam) + '</div><div class="xs muted">' + esc(r.batch) + ' \u00B7 ' + esc(r.subject) + '</div></div><span class="xs muted">' + fmt.date(r.date) + '</span></li>';
      }, 'No results entered yet.')) +
      panel('Upcoming events', 'events', list(d.upcomingEvents, parts.eventItem, 'No upcoming events.')) + '</div>';
    root.innerHTML = h;
  }

  /* ---------------------------------------------------------- student */
  function student(root, d) {
    App.setUnread(d.unread || 0);
    var h = head(d.name.split(' ')[0], 'Here is your overview for ' + fmt.date(d.today) + '.', '');
    if (d.alerts.length) h += '<div class="alert-strip">' + d.alerts.map(function (a) { return '<div class="alert ' + a.tone + '" ' + goAttr(a.go) + '>' + icon(a.icon) + '<div class="grow">' + esc(a.text) + '</div>' + icon('chevron-right') + '</div>'; }).join('') + '</div>';
    var att = d.attendance, f = d.fees, paidPct = f.finalFee ? Math.round(f.paid * 100 / f.finalFee) : 100;
    h += '<div class="grid c3" style="margin-bottom:16px">' +
      '<section class="card card-pad row nowrapflex" aria-label="Attendance">' + ui.donut(att.percent, 'attendance', d.threshold) + '<div><h3>Attendance</h3><p class="small muted">' + att.present + ' present \u00B7 ' + att.absent + ' absent</p><a href="#" class="small bold" data-go="attendance">View details</a></div></section>' +
      '<section class="card card-pad" aria-label="Fees"><div class="row between"><h3>Fees</h3>' + (f.remaining > 0 ? ui.badge('Due', 'warning') : ui.badge(f.finalFee ? 'All paid' : 'No fees', 'success')) + '</div>' +
      '<div class="stat" style="padding:10px 0"><div><div class="val">' + fmt.money(f.remaining) + '</div><div class="lbl">remaining of ' + fmt.money(f.finalFee) + '</div></div></div>' + ui.progress(paidPct, paidPct >= 100 ? 'success' : '') +
      '<p class="xs muted" style="margin-top:8px">' + (f.nextDue ? 'Next due date: ' + fmt.date(f.nextDue) : '&nbsp;') + '</p><a href="#" class="small bold" data-go="fees">View fees &amp; receipts</a></section>' +
      '<section class="card card-pad" aria-label="Next class"><h3>Next class</h3>' + (d.upcomingClasses.length ? '<div style="margin-top:10px"><div class="stat" style="padding:0"><div class="ico secondary">' + icon('clock') + '</div><div><div class="bold">' + esc(d.upcomingClasses[0].subject) + '</div><div class="small muted">' + esc(d.upcomingClasses[0].when) + (d.upcomingClasses[0].time ? ' \u00B7 ' + esc(d.upcomingClasses[0].time) : '') + '</div><div class="xs muted">' + esc(d.upcomingClasses[0].teacherName) + '</div></div></div></div>' : '<p class="small muted" style="margin-top:8px">No classes are scheduled.</p>') + '<a href="#" class="small bold" data-go="timetable" style="display:inline-block;margin-top:10px">Full timetable</a></section></div>';
    h += '<div class="grid c2">' +
      panel('Upcoming classes', 'timetable', list(d.upcomingClasses, function (c) {
        return '<li class="list-item"><div class="avatar" style="background:var(--secondary-50);color:var(--secondary)">' + icon('clock') + '</div><div class="grow"><div class="bold">' + esc(c.subject) + '</div><div class="xs muted">' + esc(c.teacherName) + '</div></div><div class="right small"><b>' + esc(c.when) + '</b><div class="xs muted">' + esc(c.time) + '</div></div></li>';
      }, 'No classes scheduled.')) +
      panel('Assignments', 'assignments', list(d.upcomingAssignments, parts.assignmentItem, 'No pending assignments. \uD83C\uDF89')) +
      panel('Recent results', 'results', list(d.recentResults, function (r) {
        return '<li class="list-item"><div class="avatar" style="background:var(--success-50);color:var(--success)">' + icon('award') + '</div><div class="grow"><div class="bold">' + esc(r.exam) + '</div><div class="xs muted">' + fmt.num(r.total) + ' / ' + fmt.num(r.maxTotal) + ' marks \u00B7 ' + r.percentage + '%</div></div>' + ui.grade(r.grade) + '</li>';
      }, 'No results published yet.')) +
      panel('Study material', 'materials', list(d.recentMaterials, parts.materialItem, 'No study material yet.')) +
      panel('Notifications', 'notifications', list(d.notifications, parts.noteItem, 'You have no notifications.')) + '</div>';
    root.innerHTML = h;
  }
})();
</script>
  <script>
/* Js_People — Approvals, Students, Teachers, Batches */
(function () {
  'use strict';
  var App = window.App, $ = App.$, esc = App.esc, icon = App.icon, ui = App.ui, fmt = App.fmt;

  function classOptions() { return (App.state.info.classes || ['8', '9', '10']).map(function (c) { return { value: c, label: 'Class ' + c }; }); }
  function batchChecks(batches, cls) {
    return batches.filter(function (b) { return b.class === String(cls) && b.status === 'ACTIVE'; }).map(function (b) { return { value: b.batch, label: b.batch + ' \u00B7 ' + b.subject }; });
  }
  function chips(list) { return list && list.length ? list.map(function (b) { return '<span class="tag">' + esc(b) + '</span>'; }).join(' ') : '<span class="muted small">None</span>'; }
  function who(name, id) { return '<div class="row nowrapflex">' + ui.avatar(name) + '<div><div class="bold">' + esc(name) + '</div><div class="xs muted">' + esc(id) + '</div></div></div>'; }

  /** Rebuilds the batch checkboxes when the class select changes. */
  function linkClassToBatches(form, batches, selected) {
    var sel = $('[name=class]', form), box = $('.checks', form);
    function paint(sel2) {
      var opts = batchChecks(batches, sel.value);
      box.innerHTML = opts.length ? opts.map(function (o) {
        return '<label class="check"><input type="checkbox" data-group="batches" value="' + esc(o.value) + '"' + (sel2.indexOf(o.value) >= 0 ? ' checked' : '') + '> ' + esc(o.label) + '</label>';
      }).join('') : '<span class="help">' + (sel.value ? 'No active batches for this class yet.' : 'Choose a class first.') + '</span>';
    }
    sel.addEventListener('change', function () { paint([]); });
    paint(selected || []);
  }

  /* ============================================================ STUDENTS */
  App.pages.students = {
    render: function (root, params, token) {
      var isAdmin = App.state.user.role === 'ADMIN';
      root.innerHTML = ui.pageHead('Students', isAdmin ? 'Add students, assign batches and manage accounts.' : 'Students in your batches.',
        isAdmin ? '<button type="button" class="btn" id="add-student">' + icon('plus') + ' Add student</button>' : '') + '<div id="list"></div>';
      return App.batches().then(function (batches) {
        if (!App.stillHere(token)) return;
        var ctrl = ui.dataList({
          root: $('#list'), pageSize: 25,
          fetch: function (p) { return App.api('students.list', p); },
          filters: [
            { key: 'q', type: 'search', placeholder: 'Search name, ID or phone' },
            { key: 'class', type: 'select', placeholder: 'All classes', options: classOptions() },
            { key: 'batch', type: 'select', placeholder: 'All batches', options: App.batchOptions(batches) }
          ].concat(isAdmin ? [{ key: 'status', type: 'select', placeholder: 'All statuses', options: ['ACTIVE', 'PENDING', 'INACTIVE', 'REJECTED'].map(function (s) { return { value: s, label: s.charAt(0) + s.slice(1).toLowerCase() }; }) }] : []),
          empty: { icon: 'users', title: 'No students found', text: isAdmin ? 'Add your first student or adjust the filters.' : 'No students are enrolled in your batches yet.' },
          columns: [
            { label: 'Student', render: function (s) { return who(s.name, s.studentId); } },
            { label: 'Class', render: function (s) { return esc(s.class); } },
            { label: 'Batches', render: function (s) { return chips(s.batches); } },
            { label: 'Phone', render: function (s) { return esc(s.phone); } }
          ].concat(isAdmin ? [
            { label: 'Status', render: function (s) { return ui.status(s.status); } },
            { label: '', actions: true, render: function (s, i) {
              return ui.act('edit', i, 'edit', 'Edit') + ui.act('fees', i, 'rupee', 'Fees') + ui.act('pw', i, 'key', 'Reset password') +
                (s.status === 'ACTIVE' ? ui.act('off', i, 'x', 'Deactivate') : (s.status === 'INACTIVE' ? ui.act('on', i, 'check', 'Activate') : ''));
            } }] : []),
          onAction: function (act, s, c) {
            if (act === 'edit') studentForm(batches, s, c);
            else if (act === 'fees') App.go('fees', { student: s });
            else if (act === 'pw') resetPw(s.userId, s.name, c);
            else if (act === 'off' || act === 'on') toggle(s.userId, s.name, act === 'on', c);
          }
        });
        var add = $('#add-student');
        if (add) add.onclick = function () { studentForm(batches, null, ctrl); };
      });
    }
  };

  function studentForm(batches, s, ctrl) {
    ui.formModal({
      title: s ? 'Edit student' : 'Add student', submitText: s ? 'Save changes' : 'Add student', size: 'lg',
      intro: s ? '' : 'The student ID becomes the login username. A password is generated for you unless you type one.',
      fields: [
        { name: 'name', label: 'Full name', required: true, value: s && s.name, attrs: 'maxlength="80"' },
        { name: 'class', label: 'Class', type: 'select', required: true, blank: 'Select class', options: classOptions(), value: s && s.class },
        { name: 'phone', label: 'Phone number', type: 'tel', required: true, value: s && s.phone, attrs: 'inputmode="numeric"', help: '10-digit mobile number' },
        s ? null : { name: 'password', label: 'Password (optional)', type: 'password', help: 'Leave blank to generate one', minlength: 0, attrs: 'autocomplete="new-password"' },
        { name: 'batches', label: 'Batches', type: 'checks', full: true, options: [], help: 'Batches follow the selected class.' }
      ].filter(Boolean),
      onOpen: function (m, form) {
        linkClassToBatches(form, batches, s ? s.batches : []);
        var pw = $('[name=password]', form); if (pw) pw.removeAttribute('minlength');
      },
      onSubmit: function (d) {
        if (s) return App.api('students.update', Object.assign({ studentId: s.studentId }, d)).then(function () { ui.toast('Student updated.', 'success'); ctrl.reload(); });
        return App.api('students.create', d).then(function (r) {
          ctrl.reload(); ui.toast('Student added.', 'success');
          if (r.password) setTimeout(function () { ui.secretDialog('Student created', [['Student ID (username)', r.username], ['Password', r.password]]); }, 200);
        });
      }
    });
  }

  function resetPw(userId, name, ctrl) {
    ui.confirm({ title: 'Reset password', message: 'Generate a new password for ' + name + '? They will be signed out.', confirmText: 'Reset password' }).then(function (ok) {
      if (!ok) return;
      App.api('users.resetPassword', { userId: userId }).then(function (r) { ui.secretDialog('New password for ' + name, [['Username', r.username], ['New password', r.password]]); }).catch(App.fail);
    });
  }
  function toggle(userId, name, activate, ctrl) {
    ui.confirm({ title: activate ? 'Activate account' : 'Deactivate account', danger: !activate, confirmText: activate ? 'Activate' : 'Deactivate',
      message: activate ? name + ' will be able to sign in again.' : name + ' will be signed out and unable to sign in until reactivated.' }).then(function (ok) {
      if (!ok) return;
      App.api('users.setStatus', { userId: userId, status: activate ? 'ACTIVE' : 'INACTIVE' }).then(function () { ui.toast(activate ? 'Account activated.' : 'Account deactivated.', 'success'); ctrl.reload(); }).catch(App.fail);
    });
  }

  /* ============================================================ TEACHERS */
  App.pages.teachers = {
    render: function (root) {
      root.innerHTML = ui.pageHead('Teachers', 'Manage teacher profiles and accounts.', '<button type="button" class="btn" id="add-teacher">' + icon('plus') + ' Add teacher</button>') + '<div id="list"></div>';
      var ctrl = ui.dataList({
        root: $('#list'), pageSize: 25, fetch: function (p) { return App.api('teachers.list', p); },
        filters: [{ key: 'q', type: 'search', placeholder: 'Search name, ID or subject' },
          { key: 'status', type: 'select', placeholder: 'All statuses', options: ['ACTIVE', 'PENDING', 'INACTIVE', 'REJECTED'].map(function (s) { return { value: s, label: s.charAt(0) + s.slice(1).toLowerCase() }; }) }],
        empty: { icon: 'briefcase', title: 'No teachers yet', text: 'Add a teacher to start creating batches.' },
        columns: [
          { label: 'Teacher', render: function (t) { return who(t.name, t.teacherId); } },
          { label: 'Subject', render: function (t) { return esc(t.subject); } },
          { label: 'Phone', render: function (t) { return esc(t.phone); } },
          { label: 'Active batches', cls: 'num', render: function (t) { return t.batches; } },
          { label: 'Status', render: function (t) { return ui.status(t.status); } },
          { label: '', actions: true, render: function (t, i) {
            return ui.act('edit', i, 'edit', 'Edit') + ui.act('pw', i, 'key', 'Reset password') + (t.status === 'ACTIVE' ? ui.act('off', i, 'x', 'Deactivate') : (t.status === 'INACTIVE' ? ui.act('on', i, 'check', 'Activate') : ''));
          } }],
        onAction: function (act, t, c) {
          if (act === 'edit') teacherForm(t, c);
          else if (act === 'pw') resetPw(t.userId, t.name, c);
          else toggle(t.userId, t.name, act === 'on', c);
        }
      });
      $('#add-teacher').onclick = function () { teacherForm(null, ctrl); };
    }
  };
  function teacherForm(t, ctrl) {
    ui.formModal({
      title: t ? 'Edit teacher' : 'Add teacher', submitText: t ? 'Save changes' : 'Add teacher',
      fields: [
        { name: 'name', label: 'Full name', required: true, value: t && t.name, full: true, attrs: 'maxlength="80"' },
        { name: 'subject', label: 'Subject', required: true, value: t && t.subject, attrs: 'maxlength="60"' },
        { name: 'phone', label: 'Phone number', type: 'tel', required: true, value: t && t.phone, attrs: 'inputmode="numeric"' },
        t ? null : { name: 'password', label: 'Password (optional)', type: 'password', full: true, help: 'Leave blank to generate one', attrs: 'autocomplete="new-password"' }
      ].filter(Boolean),
      onOpen: function (m, form) { var pw = $('[name=password]', form); if (pw) pw.removeAttribute('minlength'); },
      onSubmit: function (d) {
        if (t) return App.api('teachers.update', Object.assign({ teacherId: t.teacherId }, d)).then(function () { ui.toast('Teacher updated.', 'success'); ctrl.reload(); });
        return App.api('teachers.create', d).then(function (r) {
          ctrl.reload(); ui.toast('Teacher added.', 'success');
          if (r.password) setTimeout(function () { ui.secretDialog('Teacher created', [['Teacher ID (username)', r.username], ['Password', r.password]]); }, 200);
        });
      }
    });
  }

  /* ============================================================= BATCHES */
  function rosterDialog(batch) {
    var m = ui.modal({ title: 'Students in ' + batch, size: 'lg', body: ui.skeleton(4), footer: '<button type="button" class="btn" data-close>Close</button>' });
    App.api('batches.roster', { batch: batch }).then(function (d) {
      m.body.innerHTML = d.items.length ? ui.table([
        { label: 'Student', render: function (s) { return who(s.name, s.studentId); } },
        { label: 'Phone', render: function (s) { return esc(s.phone); } }], d.items) : ui.empty({ icon: 'users', title: 'No students in this batch', text: 'Students are added to batches by the admin.' });
    }).catch(function (e) { m.body.innerHTML = '<div class="alert error">' + esc(e.message) + '</div>'; });
  }

  function batchForm(b, teachers, done) {
    ui.formModal({
      title: b ? 'Edit batch ' + b.batch : 'Add batch', submitText: b ? 'Save changes' : 'Add batch',
      intro: b ? '' : 'Name the batch with the class first, e.g. <b>10-A-MATH</b>. Students see their timetable from the schedule text.',
      fields: [
        b ? null : { name: 'batch', label: 'Batch name', required: true, placeholder: '10-A-MATH', attrs: 'maxlength="24" style="text-transform:uppercase"' },
        b ? null : { name: 'class', label: 'Class', type: 'select', required: true, blank: 'Select class', options: classOptions() },
        { name: 'subject', label: 'Subject', required: true, value: b && b.subject, attrs: 'maxlength="60"' },
        { name: 'teacher', label: 'Teacher', type: 'select', required: true, blank: 'Select teacher', value: b && b.teacherId, options: teachers.map(function (t) { return { value: t.teacherId, label: t.name + ' \u2014 ' + t.subject }; }) },
        { name: 'schedule', label: 'Schedule', required: true, value: b && b.schedule, full: true, placeholder: 'Mon/Wed/Fri 5 PM', help: 'Days and time, e.g. "Mon/Wed/Fri 5 PM", "Mon-Sat 4:30 PM - 6 PM", "Tue/Thu 7 PM".' }
      ].filter(Boolean),
      onSubmit: function (d) {
        return App.api(b ? 'batches.update' : 'batches.create', b ? Object.assign({ batch: b.batch }, d) : d).then(function () { App.state.cache.batches = null; ui.toast(b ? 'Batch updated.' : 'Batch added.', 'success'); done(); });
      }
    });
  }

  App.pages.batches = {
    render: function (root, params, token) {
      var role = App.state.user.role;
      if (role === 'TEACHER') return teacherBatches(root, token);
      root.innerHTML = ui.pageHead('Batches', 'A batch links a class, a subject, a teacher and a weekly schedule.', '<button type="button" class="btn" id="add-batch">' + icon('plus') + ' Add batch</button>') +
        '<div class="toolbar"><div class="search">' + icon('search') + '<input class="input" id="bq" type="search" placeholder="Search batch, subject or teacher" aria-label="Search batches"></div>' +
        '<select class="select" id="bc" aria-label="Class">' + ui.opts(classOptions(), '', 'All classes') + '</select>' +
        '<select class="select" id="bs" aria-label="Status">' + ui.opts([{ value: 'ACTIVE', label: 'Active' }, { value: 'INACTIVE', label: 'Inactive' }], '', 'All statuses') + '</select></div><div id="blist">' + ui.skeleton(5) + '</div>';
      var teachers = [], all = [];
      function paint() {
        var q = $('#bq').value.toLowerCase().trim(), c = $('#bc').value, s = $('#bs').value;
        var rows = all.filter(function (b) { return (!c || b.class === c) && (!s || b.status === s) && (!q || (b.batch + ' ' + b.subject + ' ' + b.teacherName).toLowerCase().indexOf(q) >= 0); });
        $('#blist').innerHTML = rows.length ? ui.table([
          { label: 'Batch', render: function (b) { return '<b>' + esc(b.batch) + '</b>'; } },
          { label: 'Class', render: function (b) { return esc(b.class); } },
          { label: 'Subject', render: function (b) { return esc(b.subject); } },
          { label: 'Teacher', render: function (b) { return esc(b.teacherName || '\u2014'); } },
          { label: 'Schedule', render: function (b) { return esc(b.schedule); } },
          { label: 'Students', cls: 'num', render: function (b) { return b.students; } },
          { label: 'Status', render: function (b) { return ui.status(b.status); } },
          { label: '', actions: true, render: function (b, i) {
            return ui.act('roster', i, 'users', 'Students') + ui.act('edit', i, 'edit', 'Edit') + (b.status === 'ACTIVE' ? ui.act('off', i, 'x', 'Deactivate') : ui.act('on', i, 'check', 'Activate'));
          } }], rows) : '<div class="card">' + ui.empty({ icon: 'layers', title: 'No batches found', text: 'Add a batch to get started.' }) + '</div>';
        $('#blist').onclick = function (e) {
          var a = e.target.closest('[data-act]'); if (!a) return;
          var b = rows[+a.dataset.i];
          if (a.dataset.act === 'roster') rosterDialog(b.batch);
          else if (a.dataset.act === 'edit') batchForm(b, teachers, reload);
          else App.api('batches.setStatus', { batch: b.batch, status: a.dataset.act === 'on' ? 'ACTIVE' : 'INACTIVE' }).then(function () { ui.toast('Batch updated.', 'success'); reload(); }).catch(App.fail);
        };
      }
      function reload() { return App.batches(true).then(function (items) { all = items; paint(); }); }
      ['bq', 'bc', 'bs'].forEach(function (id) { $('#' + id).addEventListener('input', paint); });
      $('#add-batch').onclick = function () { batchForm(null, teachers, reload); };
      return Promise.all([reload(), App.api('teachers.list', { status: 'ACTIVE', pageSize: 100 }).then(function (d) { teachers = d.items; })]).catch(function (e) { $('#blist').innerHTML = '<div class="card">' + ui.empty({ icon: 'alert', title: 'Could not load batches', text: e.message }) + '</div>'; });
    }
  };

  function teacherBatches(root, token) {
    root.innerHTML = ui.pageHead('My batches', 'The batches assigned to you.') + '<div id="cards">' + ui.skeleton(3) + '</div>';
    return App.batches(true).then(function (items) {
      if (!App.stillHere(token)) return;
      $('#cards').innerHTML = items.length ? '<div class="grid c3">' + items.map(function (b, i) {
        return '<section class="card card-pad stack" aria-label="' + esc(b.batch) + '"><div class="row between"><h3>' + esc(b.batch) + '</h3>' + ui.status(b.status) + '</div>' +
          '<div><div class="bold">' + esc(b.subject) + '</div><div class="small muted">Class ' + esc(b.class) + ' \u00B7 ' + b.students + ' students</div></div>' +
          '<div class="small">' + icon('clock') + ' ' + esc(b.schedule) + '</div>' +
          '<div class="row"><button type="button" class="btn sm" data-go="attendance" data-param="' + esc(JSON.stringify({ batch: b.batch })) + '">Attendance</button>' +
          '<button type="button" class="btn sm secondary" data-roster="' + esc(b.batch) + '">Students</button></div></section>';
      }).join('') + '</div>' : '<div class="card">' + ui.empty({ icon: 'layers', title: 'No batches assigned yet', text: 'The admin will assign batches to you.' }) + '</div>';
      $('#cards').onclick = function (e) { var r = e.target.closest('[data-roster]'); if (r) rosterDialog(r.dataset.roster); };
    });
  }

  /* ========================================================== APPROVALS */
  App.pages.approvals = {
    render: function (root, params, token) {
      root.innerHTML = ui.pageHead('Registration approvals', 'People who registered themselves must be approved before they can sign in.') + '<div id="ap">' + ui.skeleton(5) + '</div>';
      var batches = [];
      function load() {
        return Promise.all([App.api('users.pending'), App.batches()]).then(function (r) {
          if (!App.stillHere(token)) return;
          var d = r[0]; batches = r[1]; App.setApprovals(d.total);
          var box = $('#ap');
          if (!d.total) { box.innerHTML = '<div class="card">' + ui.empty({ icon: 'check-circle', title: 'No pending registrations', text: 'New registrations will appear here.' }) + '</div>'; return; }
          box.innerHTML = '<div class="stack-lg">' +
            (d.students.length ? '<div><h2 style="margin-bottom:10px">Students (' + d.students.length + ')</h2>' + ui.table([
              { label: 'Student', render: function (s) { return who(s.name, s.studentId); } }, { label: 'Class', render: function (s) { return esc(s.class); } },
              { label: 'Phone', render: function (s) { return esc(s.phone); } }, { label: 'Registered', render: function (s) { return fmt.dateTime(s.createdAt); } },
              { label: '', actions: true, render: function (s, i) { return ui.act('ok', i, 'check', 'Approve', '') + ui.act('no', i, 'x', 'Reject', 'secondary'); } }], d.students) + '</div>' : '') +
            (d.teachers.length ? '<div><h2 style="margin-bottom:10px">Teachers (' + d.teachers.length + ')</h2>' + ui.table([
              { label: 'Teacher', render: function (t) { return who(t.name, t.teacherId); } }, { label: 'Subject', render: function (t) { return esc(t.subject); } },
              { label: 'Phone', render: function (t) { return esc(t.phone); } }, { label: 'Registered', render: function (t) { return fmt.dateTime(t.createdAt); } },
              { label: '', actions: true, render: function (t, i) { return ui.act('ok', i, 'check', 'Approve', '') + ui.act('no', i, 'x', 'Reject', 'secondary'); } }], d.teachers) + '</div>' : '') + '</div>';
          var tables = box.querySelectorAll('.table-wrap');
          var idx = 0, sTable = d.students.length ? tables[idx++] : null, tTable = d.teachers.length ? tables[idx++] : null;
          if (sTable) sTable.onclick = function (e) { var a = e.target.closest('[data-act]'); if (a) act(d.students[+a.dataset.i], a.dataset.act, true); };
          if (tTable) tTable.onclick = function (e) { var a = e.target.closest('[data-act]'); if (a) act(d.teachers[+a.dataset.i], a.dataset.act, false); };
        });
      }
      function act(p, what, isStudent) {
        if (what === 'no') {
          ui.confirm({ title: 'Reject registration', danger: true, confirmText: 'Reject', message: 'Reject the registration of ' + p.name + '? They will not be able to sign in.' }).then(function (ok) {
            if (ok) App.api('users.reject', { userId: p.userId }).then(function () { ui.toast('Registration rejected.'); load(); }).catch(App.fail);
          });
        } else if (isStudent) {
          ui.formModal({
            title: 'Approve ' + p.name, submitText: 'Approve student', intro: 'Class ' + esc(p.class) + '. Choose the batches this student joins (you can change this later).',
            fields: [{ name: 'batches', label: 'Batches', type: 'checks', full: true, options: batchChecks(batches, p.class), emptyText: 'No active batches for this class yet.' }],
            onSubmit: function (d) { return App.api('users.approve', { userId: p.userId, batches: d.batches }).then(function () { ui.toast('Student approved.', 'success'); load(); }); }
          });
        } else {
          App.api('users.approve', { userId: p.userId }).then(function () { ui.toast('Teacher approved.', 'success'); load(); }).catch(App.fail);
        }
      }
      return load();
    }
  };
})();
</script>
  <script>
/* Js_Attendance — take/edit attendance, reports, overview (admin/teacher) + own attendance (student) */
(function () {
  'use strict';
  var App = window.App, $ = App.$, $$ = App.$$, esc = App.esc, icon = App.icon, ui = App.ui, fmt = App.fmt;

  function tabsHtml(defs, active) {
    return '<div class="tabs" role="tablist">' + defs.map(function (t) { return '<button type="button" class="tab" role="tab" data-tab="' + t[0] + '" aria-selected="' + (t[0] === active) + '">' + esc(t[1]) + '</button>'; }).join('') + '</div>';
  }
  function shiftMonth(ym, n) {
    var y = +ym.substr(0, 4), m = +ym.substr(5, 2) - 1 + n;
    y += Math.floor(m / 12); m = ((m % 12) + 12) % 12;
    return y + '-' + String(m + 1).padStart(2, '0');
  }

  App.pages.attendance = {
    render: function (root, params, token) {
      if (App.state.user.role === 'STUDENT') return studentView(root, token);
      var isAdmin = App.state.user.role === 'ADMIN';
      var defs = [['mark', 'Take attendance'], ['report', 'Reports & history']].concat(isAdmin ? [['overview', 'Daily overview']] : []);
      var active = params && params.tab ? params.tab : (params && params.overview ? 'overview' : 'mark');
      root.innerHTML = ui.pageHead('Attendance', 'Mark attendance, review reports and correct mistakes.') + tabsHtml(defs, active) + '<div id="tab-body">' + ui.skeleton(4) + '</div>';
      return App.batches().then(function (all) {
        if (!App.stillHere(token)) return;
        var batches = all.filter(function (b) { return b.status === 'ACTIVE'; });
        var body = $('#tab-body');
        function show(tab) {
          $$('.tab', root).forEach(function (t) { t.setAttribute('aria-selected', t.dataset.tab === tab); });
          if (tab === 'mark') markTab(body, batches, params || {});
          else if (tab === 'report') reportTab(body, batches, function (b, d) { show('mark'); markTab(body, batches, { batch: b, date: d }); });
          else overviewTab(body, function (b, d) { show('mark'); markTab(body, batches, { batch: b, date: d }); });
        }
        root.querySelector('.tabs').onclick = function (e) { var t = e.target.closest('[data-tab]'); if (t) { params = {}; show(t.dataset.tab); } };
        show(active);
      });
    }
  };

  /* ----------------------------------------------------------- mark */
  function markTab(box, batches, pre) {
    if (!batches.length) { box.innerHTML = '<div class="card">' + ui.empty({ icon: 'layers', title: 'No active batches', text: 'Batches must exist before attendance can be taken.' }) + '</div>'; return; }
    var today = fmt.today();
    box.innerHTML = '<div class="card card-pad"><div class="form-grid">' +
      ui.field({ id: 'a-batch', name: 'a-batch', label: 'Batch', type: 'select', options: App.batchOptions(batches), value: pre.batch || batches[0].batch }) +
      ui.field({ id: 'a-date', name: 'a-date', label: 'Date', type: 'date', value: pre.date || today, max: today }) +
      '</div></div><div id="sheet" style="margin-top:16px"></div>';
    var sheetBox = $('#sheet'), cur = null;

    function load() {
      var b = $('#a-batch').value, d = $('#a-date').value;
      if (!d) { sheetBox.innerHTML = '<div class="alert info">' + icon('info') + '<div>Please choose a date.</div></div>'; return; }
      if (d > today) { sheetBox.innerHTML = '<div class="alert warning">' + icon('alert') + '<div>Attendance cannot be marked for a future date.</div></div>'; return; }
      sheetBox.innerHTML = '<div class="card card-pad">' + ui.skeleton(6) + '</div>';
      App.api('attendance.sheet', { batch: b, date: d }).then(function (s) { cur = s; paint(); }).catch(function (e) {
        sheetBox.innerHTML = '<div class="card">' + ui.empty({ icon: 'alert', title: 'Could not open the attendance sheet', text: e.message }) + '</div>'; App.fail(e);
      });
    }
    function counts() { var a = cur.students.filter(function (s) { return s.status === 'ABSENT'; }).length; return { a: a, p: cur.students.length - a }; }
    function rowHtml(s, i) {
      var ab = s.status === 'ABSENT';
      return '<div class="att-row' + (ab ? ' absent' : '') + '" data-i="' + i + '"><div class="who"><div class="bold">' + esc(s.name) + '</div><div class="xs muted">' + esc(s.studentId) + '</div></div>' +
        '<div class="seg" role="group" aria-label="Attendance for ' + esc(s.name) + '"><button type="button" class="p" data-set="PRESENT" aria-pressed="' + !ab + '">Present</button><button type="button" class="a" data-set="ABSENT" aria-pressed="' + ab + '">Absent</button></div>' +
        '<div class="att-note' + (ab ? '' : ' hidden') + '"><input class="input" data-remark placeholder="Reason (optional)" maxlength="60" aria-label="Reason for ' + esc(s.name) + '" value="' + esc(s.remark) + '"></div></div>';
    }
    function paint() {
      if (!cur.students.length) { sheetBox.innerHTML = '<div class="card">' + ui.empty({ icon: 'users', title: 'No students in this batch', text: 'Students must be added to the batch before attendance can be taken.' }) + '</div>'; return; }
      var c = counts();
      sheetBox.innerHTML = (cur.exists ? '<div class="alert info" style="margin-bottom:12px">' + icon('info') + '<div>Attendance for this date was already saved' + (cur.updatedAt ? ' (' + esc(fmt.dateTime(cur.updatedAt)) + ')' : '') + '. You are editing it.</div></div>' : '') +
        '<section class="card" aria-label="Attendance sheet"><div class="card-head"><div><h3>' + esc(cur.batch) + ' \u00B7 ' + esc(cur.subject) + '</h3><div class="xs muted">' + esc(fmt.date(cur.date)) + ' \u00B7 ' + cur.students.length + ' students</div></div>' +
        '<div class="row"><button type="button" class="btn secondary sm" id="all-p">' + icon('check') + ' Mark all present</button></div></div>' +
        '<div>' + cur.students.map(rowHtml).join('') + '</div>' +
        '<div class="sticky-bar"><div class="row"><span class="badge success" id="cnt-p">' + c.p + ' present</span><span class="badge error" id="cnt-a">' + c.a + ' absent</span></div><button type="button" class="btn" id="save-att">' + icon('check-circle') + ' Save attendance</button></div></section>';
      $('#save-att').onclick = save; $('#all-p').onclick = function () { cur.students.forEach(function (s) { s.status = 'PRESENT'; s.remark = ''; }); paint(); };
      sheetBox.querySelector('section').addEventListener('click', function (e) {
        var b = e.target.closest('[data-set]'); if (!b) return;
        var row = b.closest('.att-row'), s = cur.students[+row.dataset.i];
        s.status = b.dataset.set;
        var tmp = document.createElement('div'); tmp.innerHTML = rowHtml(s, +row.dataset.i);
        row.replaceWith(tmp.firstChild);
        var cc = counts(); $('#cnt-p').textContent = cc.p + ' present'; $('#cnt-a').textContent = cc.a + ' absent';
        if (s.status === 'ABSENT') { var inp = $('.att-row[data-i="' + row.dataset.i + '"] [data-remark]'); if (inp) inp.focus(); }
      });
      sheetBox.querySelector('section').addEventListener('input', function (e) { if (e.target.dataset.remark !== undefined) cur.students[+e.target.closest('.att-row').dataset.i].remark = e.target.value; });
    }
    function save() {
      var records = cur.students.map(function (s) { return { studentId: s.studentId, status: s.status, remark: s.remark }; });
      ui.busy($('#save-att'), App.api('attendance.save', { batch: cur.batch, date: cur.date, records: records })).then(function (r) {
        ui.toast('Attendance saved \u2014 ' + r.present + ' present, ' + r.absent + ' absent.', 'success'); cur.exists = true; cur.updatedAt = fmt.today() + ' ' + new Date().toTimeString().substr(0, 5); paint();
      }).catch(App.fail);
    }
    $('#a-batch').onchange = load; $('#a-date').onchange = load;
    load();
  }

  /* --------------------------------------------------------- report */
  function reportTab(box, batches, openDay) {
    if (!batches.length) { box.innerHTML = '<div class="card">' + ui.empty({ icon: 'layers', title: 'No active batches' }) + '</div>'; return; }
    var today = fmt.today();
    box.innerHTML = '<div class="card card-pad"><div class="form-grid" style="grid-template-columns:repeat(3,minmax(0,1fr))">' +
      ui.field({ id: 'r-batch', name: 'r-batch', label: 'Batch', type: 'select', options: App.batchOptions(batches) }) +
      ui.field({ id: 'r-from', name: 'r-from', label: 'From', type: 'date', value: today.substr(0, 8) + '01', max: today }) +
      ui.field({ id: 'r-to', name: 'r-to', label: 'To', type: 'date', value: today, max: today }) + '</div></div><div id="rep" style="margin-top:16px"></div>';
    var rep = $('#rep');
    function load() {
      var b = $('#r-batch').value, f = $('#r-from').value, t = $('#r-to').value;
      rep.innerHTML = '<div class="card card-pad">' + ui.skeleton(5) + '</div>';
      Promise.all([App.api('attendance.report', { batch: b, from: f, to: t }), App.api('attendance.history', { batch: b, month: t.substr(0, 7) })]).then(function (r) {
        var d = r[0], h = r[1];
        rep.innerHTML = '<div class="stack-lg"><div><div class="row between" style="margin-bottom:10px"><h2>' + esc(d.batch) + ' \u00B7 ' + esc(d.subject) + '</h2><span class="muted small">' + d.sessions + ' session' + (d.sessions === 1 ? '' : 's') + ' recorded</span></div>' +
          (d.students.length ? ui.table([
            { label: 'Student', render: function (s) { return '<b>' + esc(s.name) + '</b><div class="xs muted">' + esc(s.studentId) + '</div>'; } },
            { label: 'Present', cls: 'num', render: function (s) { return s.present; } }, { label: 'Absent', cls: 'num', render: function (s) { return s.absent; } },
            { label: 'Attendance', render: function (s) { return s.total ? '<div style="min-width:120px"><div class="row between xs"><b>' + s.percent + '%</b>' + (s.low ? ui.badge('Low', 'warning') : '') + '</div>' + ui.progress(s.percent, s.low ? 'warning' : 'success') + '</div>' : '<span class="muted small">No data</span>'; } }], d.students) : '<div class="card">' + ui.empty({ icon: 'users', title: 'No students in this batch' }) + '</div>') + '</div>' +
          '<div><h3 style="margin-bottom:10px">Days recorded in ' + esc(fmt.monthLabel(h.month)) + '</h3>' + (h.items.length ? '<div class="row">' + h.items.map(function (x) {
            return '<button type="button" class="day-chip" data-day="' + x.date + '" title="Open and edit this day"><b>' + esc(fmt.date(x.date).split(' ').slice(0, 2).join(' ')) + '</b><span style="color:var(--success)">' + x.present + ' P</span><span style="color:var(--error)">' + x.absent + ' A</span></button>'; }).join('') + '</div>' : '<p class="muted small">No attendance recorded in this month.</p>') + '</div></div>';
        rep.onclick = function (e) { var c = e.target.closest('[data-day]'); if (c) openDay(b, c.dataset.day); };
      }).catch(function (e) { rep.innerHTML = '<div class="card">' + ui.empty({ icon: 'alert', title: 'Could not load the report', text: e.message }) + '</div>'; App.fail(e); });
    }
    ['r-batch', 'r-from', 'r-to'].forEach(function (id) { $('#' + id).onchange = load; });
    load();
  }

  /* ------------------------------------------------------- overview */
  function overviewTab(box, open) {
    var today = fmt.today();
    box.innerHTML = '<div class="card card-pad" style="max-width:320px">' + ui.field({ id: 'o-date', name: 'o-date', label: 'Date', type: 'date', value: today, max: today }) + '</div><div id="ov" style="margin-top:16px"></div>';
    function load() {
      var d = $('#o-date').value, ov = $('#ov');
      ov.innerHTML = '<div class="card card-pad">' + ui.skeleton(5) + '</div>';
      App.api('attendance.overview', { date: d }).then(function (r) {
        var t = r.totals;
        ov.innerHTML = '<div class="grid c4" style="margin-bottom:16px">' + ui.stat('layers', t.scheduled, 'Batches scheduled') + ui.stat('check-circle', t.marked, 'Batches marked', 'success') + ui.stat('users', t.present, 'Present', 'secondary') + ui.stat('alert', t.absent, 'Absent', 'error') + '</div>' +
          (r.items.length ? ui.table([
            { label: 'Batch', render: function (b) { return '<b>' + esc(b.batch) + '</b> <span class="muted">\u00B7 ' + esc(b.subject) + '</span>'; } },
            { label: 'Teacher', render: function (b) { return esc(b.teacherName); } }, { label: 'Time', render: function (b) { return esc(b.time || '\u2014'); } },
            { label: 'Scheduled', render: function (b) { return b.scheduled ? 'Yes' : '<span class="muted">No</span>'; } },
            { label: 'Status', render: function (b) { return b.marked ? ui.badge(b.present + ' present / ' + b.absent + ' absent', 'success') : (b.scheduled ? ui.badge('Not marked', 'warning') : '<span class="muted">\u2014</span>'); } },
            { label: '', actions: true, render: function (b, i) { return ui.act('open', i, 'edit', b.marked ? 'Edit' : 'Mark'); } }], r.items) : '<div class="card">' + ui.empty({ icon: 'layers', title: 'No active batches' }) + '</div>');
        ov.onclick = function (e) { var a = e.target.closest('[data-act]'); if (a) open(r.items[+a.dataset.i].batch, d); };
      }).catch(function (e) { ov.innerHTML = '<div class="card">' + ui.empty({ icon: 'alert', title: 'Could not load the overview', text: e.message }) + '</div>'; App.fail(e); });
    }
    $('#o-date').onchange = load; load();
  }

  /* -------------------------------------------------------- student */
  function studentView(root, token) {
    var month = fmt.month();
    root.innerHTML = ui.pageHead('My attendance', 'Your attendance across all subjects.') + '<div id="att">' + ui.skeleton(5) + '</div>';
    function load() {
      return App.api('attendance.my', { month: month }).then(function (d) {
        if (!App.stillHere(token)) return;
        var o = d.overall, low = o.total > 0 && o.percent < d.threshold;
        $('#att').innerHTML = '<div class="stack-lg">' +
          (low ? '<div class="alert warning">' + icon('alert') + '<div><b>Your attendance is below ' + d.threshold + '%.</b> Please try to attend more classes.</div></div>' : '') +
          '<div class="grid c3"><section class="card card-pad row nowrapflex">' + ui.donut(o.percent, 'overall', d.threshold) + '<div><h3>Overall</h3><p class="small muted">' + o.present + ' present<br>' + o.absent + ' absent<br>' + o.total + ' classes recorded</p></div></section>' +
          (d.byBatch.length ? d.byBatch.map(function (b) {
            var lo = b.total > 0 && b.percent < d.threshold;
            return '<section class="card card-pad stack"><div class="row between"><h3>' + esc(b.subject || b.batch) + '</h3>' + (lo ? ui.badge('Low', 'warning') : ui.badge('Good', 'success')) + '</div><div class="stat" style="padding:0"><div><div class="val">' + b.percent + '%</div><div class="lbl">' + b.present + ' of ' + b.total + ' classes</div></div></div>' + ui.progress(b.percent, lo ? 'warning' : 'success') + '</section>';
          }).join('') : '<div class="card grow" style="grid-column:span 2">' + ui.empty({ icon: 'clipboard', title: 'No attendance recorded yet', text: 'It will appear here once your teacher marks attendance.' }) + '</div>') + '</div>' +
          '<section><div class="row between" style="margin-bottom:10px"><h2>Daily record</h2><div class="row nowrapflex"><button type="button" class="btn secondary sm icon-only" id="pm" aria-label="Previous month">' + icon('chevron-left') + '</button><b style="min-width:110px;text-align:center">' + esc(fmt.monthLabel(month)) + '</b><button type="button" class="btn secondary sm icon-only" id="nm" aria-label="Next month"' + (month >= fmt.month() ? ' disabled' : '') + '>' + icon('chevron-right') + '</button></div></div>' +
          (d.days.length ? ui.table([{ label: 'Date', render: function (x) { return esc(fmt.date(x.date)); } }, { label: 'Subject', render: function (x) { return esc(x.subject || x.batch); } },
            { label: 'Status', render: function (x) { return ui.status(x.status); } }, { label: 'Remark', render: function (x) { return esc(x.remark || '\u2014'); } }], d.days) : '<div class="card">' + ui.empty({ icon: 'calendar', title: 'No classes recorded in ' + fmt.monthLabel(month) }) + '</div>') + '</section></div>';
        $('#pm').onclick = function () { month = shiftMonth(month, -1); $('#att').innerHTML = ui.skeleton(5); load(); };
        $('#nm').onclick = function () { month = shiftMonth(month, 1); $('#att').innerHTML = ui.skeleton(5); load(); };
      });
    }
    return load();
  }
})();
</script>
  <script>
/* Js_Content — Assignments, Study Material, Events */
(function () {
  'use strict';
  var App = window.App, $ = App.$, $$ = App.$$, esc = App.esc, icon = App.icon, ui = App.ui, fmt = App.fmt;

  /* ============================================== generic content pages */
  function makePage(cfg) {
    return {
      render: function (root, params, token) {
        var isStaff = App.state.user.role !== 'STUDENT';
        root.innerHTML = ui.pageHead(cfg.title, isStaff ? cfg.staffSub : cfg.studentSub, isStaff ? '<button type="button" class="btn" id="add-c">' + icon('plus') + ' New ' + cfg.noun + '</button>' : '') + '<div id="clist"></div>';
        return App.batches().then(function (batches) {
          if (!App.stillHere(token)) return;
          if (isStaff) staffList(cfg, batches, params);
          else studentList(cfg, batches);
        });
      }
    };
  }

  function staffList(cfg, batches, params) {
    var active = batches.filter(function (b) { return b.status === 'ACTIVE'; });
    var ctrl = ui.dataList({
      root: $('#clist'), pageSize: 20, fetch: function (p) { return App.api(cfg.list, p); },
      filters: [{ key: 'q', type: 'search', placeholder: 'Search by title or subject' },
        { key: 'batch', type: 'select', placeholder: 'All batches', options: App.batchOptions(batches) },
        { key: 'status', type: 'select', placeholder: 'All statuses', options: [{ value: 'PUBLISHED', label: 'Published' }, { value: 'ARCHIVED', label: 'Archived' }] }],
      empty: { icon: cfg.icon, title: 'No ' + cfg.plural + ' yet', text: 'Use the "New ' + cfg.noun + '" button to add one.' },
      columns: [
        { label: 'Title', render: function (x) { return '<div class="bold">' + esc(x.title) + '</div>' + (x.description ? '<div class="xs muted">' + esc(x.description).substr(0, 90) + '</div>' : ''); } },
        { label: 'Batch', render: function (x) { return '<span class="tag">' + esc(x.batch) + '</span> <span class="xs muted">' + esc(x.subject) + '</span>'; } }
      ].concat(cfg.staffColumns).concat([
        { label: 'Status', render: function (x) { return ui.status(x.status); } },
        { label: '', actions: true, render: function (x, i) {
          return (x.hasFile ? ui.act('file', i, 'download', 'Download') : '') + (x.mine ? ui.act('edit', i, 'edit', 'Edit') + (x.status === 'PUBLISHED' ? ui.act('arch', i, 'folder', 'Archive') : ui.act('rest', i, 'refresh', 'Restore')) : '');
        } }]),
      onAction: function (act, x, c, btn) {
        if (act === 'file') App.download(btn, cfg.file, idPayload(cfg, x));
        else if (act === 'edit') form(cfg, active, x, c);
        else {
          var to = act === 'arch' ? 'ARCHIVED' : 'PUBLISHED', p = idPayload(cfg, x); p.status = to;
          App.api(cfg.setStatus, p).then(function () { ui.toast(act === 'arch' ? 'Archived. Students can no longer see it.' : 'Restored.', 'success'); c.reload(); }).catch(App.fail);
        }
      }
    });
    $('#add-c').onclick = function () { form(cfg, active, null, ctrl); };
    if (params && params.create) form(cfg, active, null, ctrl);
  }
  function idPayload(cfg, x) { var p = {}; p[cfg.idKey] = x[cfg.idKey]; return p; }

  function form(cfg, active, x, ctrl) {
    if (!x && !active.length) { ui.toast('There are no active batches yet. Ask the admin to create one.', 'error'); return; }
    var fields = [];
    if (!x) fields.push({ name: 'batch', label: 'Batch', type: 'select', required: true, full: true, options: App.batchOptions(active), blank: 'Select batch' });
    fields.push({ name: 'title', label: 'Title', required: true, full: true, value: x && x.title, attrs: 'maxlength="120"' });
    fields.push({ name: 'description', label: 'Description (optional)', type: 'textarea', full: true, value: x && x.description, attrs: 'maxlength="1000"' });
    cfg.formFields(x).forEach(function (f) { fields.push(f); });
    fields.push({ id: 'f-file', name: 'file', label: cfg.fileLabel + (x && x.hasFile ? ' (leave empty to keep "' + x.fileName + '")' : ''), type: 'file', full: true, accept: cfg.accept, required: !x && cfg.fileRequired, help: cfg.fileHelp });
    ui.formModal({
      title: (x ? 'Edit ' : 'New ') + cfg.noun, submitText: x ? 'Save changes' : 'Publish ' + cfg.noun, size: 'lg', fields: fields,
      onSubmit: function (d, f) {
        return ui.readFile($('#f-file', f), cfg.kind).then(function (file) {
          var p = Object.assign({}, d); delete p.file;
          if (file) p.file = file;
          if (x) p[cfg.idKey] = x[cfg.idKey];
          return App.api(cfg.save, p);
        }).then(function () { ui.toast(cfg.noun.charAt(0).toUpperCase() + cfg.noun.slice(1) + (x ? ' updated.' : ' published. Students of the batch have been notified.'), 'success'); ctrl.reload(); });
      }
    });
  }

  function studentList(cfg, batches) {
    var box = $('#clist'), items = [];
    box.innerHTML = ui.skeleton(5);
    App.api(cfg.list, { pageSize: 100 }).then(function (d) {
      items = d.items;
      var subjects = Object.keys(items.reduce(function (m, a) { m[a.subject] = 1; return m; }, {})).sort();
      box.innerHTML = (items.length ? '<div class="toolbar"><div class="search">' + icon('search') + '<input class="input" id="sq" type="search" placeholder="Search" aria-label="Search"></div><select class="select" id="ss" aria-label="Subject">' + ui.opts(subjects, '', 'All subjects') + '</select></div>' : '') + '<div id="sl"></div>';
      function paint() {
        var q = ($('#sq') ? $('#sq').value : '').toLowerCase().trim(), s = $('#ss') ? $('#ss').value : '';
        var rows = items.filter(function (a) { return (!s || a.subject === s) && (!q || (a.title + ' ' + a.description).toLowerCase().indexOf(q) >= 0); });
        if (!rows.length) { $('#sl').innerHTML = '<div class="card">' + ui.empty({ icon: cfg.icon, title: items.length ? 'Nothing matches your search' : 'No ' + cfg.plural + ' yet', text: items.length ? '' : 'Your teachers have not posted any ' + cfg.plural + ' yet.' }) + '</div>'; return; }
        var html = '', last = null;
        rows.forEach(function (a, i) {
          var g = cfg.group ? cfg.group(a) : null;
          if (g !== last && g) { html += '<h2 style="margin:' + (last === null ? '0' : '22px') + ' 0 10px">' + esc(g) + '</h2>'; }
          last = g;
          html += '<article class="card card-pad row nowrapflex" style="margin-bottom:10px;align-items:flex-start"><div class="avatar" style="background:var(--' + (cfg.key === 'assignments' ? 'warning-50);color:var(--warning' : 'secondary-50);color:var(--secondary') + ')">' + icon(cfg.icon) + '</div>' +
            '<div class="grow"><div class="row between nowrapflex" style="align-items:flex-start"><div><h3>' + esc(a.title) + '</h3><div class="xs muted">' + esc(a.subject) + ' \u00B7 ' + esc(a.createdBy || a.batch) + ' \u00B7 ' + cfg.studentMeta(a) + '</div></div>' + cfg.studentBadge(a) + '</div>' +
            (a.description ? '<p class="small" style="margin-top:8px;white-space:pre-line">' + esc(a.description) + '</p>' : '') +
            (a.hasFile ? '<div style="margin-top:10px"><button type="button" class="btn sm secondary" data-dl="' + i + '">' + icon('download') + ' Download ' + esc(a.fileName || 'file') + '</button></div>' : '') + '</div></article>';
        });
        $('#sl').innerHTML = html;
        $('#sl').onclick = function (e) { var b = e.target.closest('[data-dl]'); if (b) App.download(b, cfg.file, idPayload(cfg, rows[+b.dataset.dl])); };
      }
      ['sq', 'ss'].forEach(function (id) { if ($('#' + id)) $('#' + id).addEventListener('input', paint); });
      paint();
    }).catch(function (e) { box.innerHTML = '<div class="card">' + ui.empty({ icon: 'alert', title: 'Could not load ' + cfg.plural, text: e.message }) + '</div>'; App.fail(e); });
  }

  App.pages.assignments = makePage({
    key: 'assignments', title: 'Assignments', noun: 'assignment', plural: 'assignments', icon: 'file', kind: 'assignment', idKey: 'assignmentId',
    list: 'assignments.list', save: 'assignments.save', setStatus: 'assignments.setStatus', file: 'assignments.file',
    staffSub: 'Post homework for your batches. Students are notified automatically.', studentSub: 'Homework and tasks from your teachers.',
    accept: '.pdf,application/pdf', fileLabel: 'PDF file (optional)', fileHelp: 'PDF only, up to 10 MB.', fileRequired: false,
    formFields: function (x) { return [{ name: 'issueDate', label: 'Issue date', type: 'date', required: true, value: (x && x.issueDate) || fmt.today() }, { name: 'dueDate', label: 'Due date', type: 'date', required: true, value: x && x.dueDate }]; },
    staffColumns: [{ label: 'Issued', render: function (x) { return fmt.date(x.issueDate); } }, { label: 'Due', render: function (x) { return fmt.date(x.dueDate) + '<div class="xs">' + ui.badge(fmt.due(x), x.overdue ? 'error' : 'info') + '</div>'; } }],
    group: function (a) { return a.overdue ? 'Past due' : 'Upcoming'; },
    studentMeta: function (a) { return 'Issued ' + fmt.date(a.issueDate) + ' \u00B7 Due ' + fmt.date(a.dueDate); },
    studentBadge: function (a) { return ui.badge(fmt.due(a), a.overdue ? 'error' : (a.daysLeft <= 2 ? 'warning' : 'info')); }
  });

  App.pages.materials = makePage({
    key: 'materials', title: 'Study material', noun: 'study material', plural: 'study materials', icon: 'book', kind: 'material', idKey: 'materialId',
    list: 'materials.list', save: 'materials.save', setStatus: 'materials.setStatus', file: 'materials.file',
    staffSub: 'Upload notes, worksheets and other files for your batches.', studentSub: 'Notes and files shared by your teachers.',
    accept: '.pdf,.doc,.docx,.ppt,.pptx,.xls,.xlsx,.jpg,.jpeg,.png', fileLabel: 'File', fileHelp: 'PDF, Word, PowerPoint, Excel, JPG or PNG \u2014 up to 10 MB.', fileRequired: true,
    formFields: function () { return []; },
    staffColumns: [{ label: 'Added', render: function (x) { return fmt.date(x.date); } }],
    group: null, studentMeta: function (a) { return fmt.date(a.date); }, studentBadge: function () { return ''; }
  });

  /* ================================================================ EVENTS */
  var EVENT_TYPES = ['Test', 'Holiday', 'Special Class', 'Parent Meeting', 'Institute Event'];
  var TONE = { Holiday: 'success', Test: 'error', 'Parent Meeting': 'warning', 'Special Class': 'info' };

  function targetOptions(batches) {
    var o = [];
    if (App.state.user.role === 'ADMIN') {
      o.push({ value: 'ALL', label: 'Everyone' });
      (App.state.info.classes || []).forEach(function (c) { o.push({ value: 'CLASS_' + c, label: 'All of Class ' + c }); });
    }
    batches.filter(function (b) { return b.status === 'ACTIVE'; }).forEach(function (b) { o.push({ value: b.batch, label: 'Batch ' + b.batch + ' \u2014 ' + b.subject }); });
    return o;
  }
  function targetLabel(t) { return t === 'ALL' ? 'Everyone' : (/^CLASS_/.test(t) ? t.replace('CLASS_', 'Class ') : 'Batch ' + t); }

  App.pages.events = {
    render: function (root, params, token) {
      var isStaff = App.state.user.role !== 'STUDENT', scope = 'upcoming';
      root.innerHTML = ui.pageHead('Events', isStaff ? 'Tests, holidays, special classes and meetings.' : 'Tests, holidays and meetings for you.', isStaff ? '<button type="button" class="btn" id="add-ev">' + icon('plus') + ' New event</button>' : '') +
        '<div class="tabs" role="tablist"><button type="button" class="tab" role="tab" data-scope="upcoming" aria-selected="true">Upcoming</button><button type="button" class="tab" role="tab" data-scope="past" aria-selected="false">Past</button></div><div id="evl">' + ui.skeleton(4) + '</div>';
      var batches = [];
      function load() {
        $('#evl').innerHTML = ui.skeleton(4);
        return App.api('events.list', { scope: scope, pageSize: 60 }).then(function (d) {
          if (!App.stillHere(token)) return;
          if (!d.items.length) { $('#evl').innerHTML = '<div class="card">' + ui.empty({ icon: 'calendar', title: scope === 'upcoming' ? 'No upcoming events' : 'No past events', text: isStaff && scope === 'upcoming' ? 'Create an event to inform students.' : '' }) + '</div>'; return; }
          var html = '', lastMonth = '';
          d.items.forEach(function (e, i) {
            var m = fmt.monthLabel(String(e.date).substr(0, 7));
            if (m !== lastMonth) { html += '<h2 style="margin:' + (lastMonth ? '22px' : '0') + ' 0 10px">' + esc(m) + '</h2>'; lastMonth = m; }
            var dd = /^(\d{4})-(\d{2})-(\d{2})$/.exec(e.date) || [];
            html += '<article class="card card-pad row nowrapflex" style="margin-bottom:10px;align-items:flex-start"><div class="avatar" style="border-radius:12px;width:52px;height:52px;flex-direction:column;line-height:1.1"><b style="font-size:18px">' + (dd[3] ? +dd[3] : '') + '</b><span style="font-size:11px">' + esc(fmt.date(e.date).split(' ')[1] || '') + '</span></div>' +
              '<div class="grow"><div class="row between nowrapflex" style="align-items:flex-start"><div><h3>' + esc(e.title) + '</h3><div class="xs muted">' + (e.time ? esc(e.time) + ' \u00B7 ' : '') + esc(targetLabel(e.target)) + (e.createdBy ? ' \u00B7 by ' + esc(e.createdBy) : '') + '</div></div>' + ui.badge(e.eventType, TONE[e.eventType] || 'primary') + '</div>' +
              (e.description ? '<p class="small" style="margin-top:8px;white-space:pre-line">' + esc(e.description) + '</p>' : '') +
              (e.mine ? '<div class="row" style="margin-top:10px"><button type="button" class="btn sm secondary" data-ed="' + i + '">' + icon('edit') + ' Edit</button><button type="button" class="btn sm secondary" data-del="' + i + '">' + icon('trash') + ' Delete</button></div>' : '') + '</div></article>';
          });
          $('#evl').innerHTML = html;
          $('#evl').onclick = function (ev) {
            var ed = ev.target.closest('[data-ed]'), del = ev.target.closest('[data-del]');
            if (ed) eventForm(d.items[+ed.dataset.ed]);
            else if (del) { var e2 = d.items[+del.dataset.del]; ui.confirm({ title: 'Delete event', danger: true, confirmText: 'Delete', message: 'Delete "' + e2.title + '"?' }).then(function (ok) { if (ok) App.api('events.remove', { eventId: e2.eventId }).then(function () { ui.toast('Event deleted.', 'success'); load(); }).catch(App.fail); }); }
          };
        }).catch(function (e) { $('#evl').innerHTML = '<div class="card">' + ui.empty({ icon: 'alert', title: 'Could not load events', text: e.message }) + '</div>'; App.fail(e); });
      }
      function eventForm(x) {
        var opts = targetOptions(batches);
        if (!opts.length) { ui.toast('There are no active batches to create an event for.', 'error'); return; }
        ui.formModal({
          title: x ? 'Edit event' : 'New event', submitText: x ? 'Save changes' : 'Create event', size: 'lg',
          fields: [
            { name: 'title', label: 'Title', required: true, full: true, value: x && x.title, attrs: 'maxlength="120"' },
            { name: 'eventType', label: 'Type', type: 'select', required: true, options: EVENT_TYPES, value: x ? x.eventType : 'Test' },
            { name: 'target', label: 'For', type: 'select', required: true, options: opts, value: x ? x.target : opts[0].value },
            { name: 'date', label: 'Date', type: 'date', required: true, value: x ? x.date : fmt.today() },
            { name: 'time', label: 'Time (optional)', value: x && x.time, placeholder: 'e.g. 5:00 PM', attrs: 'maxlength="20"' },
            { name: 'description', label: 'Details (optional)', type: 'textarea', full: true, value: x && x.description, attrs: 'maxlength="500"' },
            x ? null : { name: 'notify', label: 'Notify students', type: 'select', options: [{ value: 'yes', label: 'Yes \u2014 send a notification' }, { value: 'no', label: 'No' }], value: 'yes' }
          ].filter(Boolean),
          onSubmit: function (d) {
            var p = Object.assign({}, d); if (x) p.eventId = x.eventId; else p.notify = d.notify !== 'no';
            return App.api('events.save', p).then(function () { ui.toast(x ? 'Event updated.' : 'Event created.', 'success'); load(); });
          }
        });
      }
      root.querySelector('.tabs').onclick = function (e) { var t = e.target.closest('[data-scope]'); if (!t) return; scope = t.dataset.scope; $$('.tab', root).forEach(function (b) { b.setAttribute('aria-selected', b === t); }); load(); };
      if (isStaff) $('#add-ev').onclick = function () { eventForm(null); };
      return App.batches().then(function (b) { batches = b; return load(); });
    }
  };
})();
</script>
  <script>
/* Js_Results — enter marks (teacher/admin), browse results (admin), my results (student) */
(function () {
  'use strict';
  var App = window.App, $ = App.$, $$ = App.$$, esc = App.esc, icon = App.icon, ui = App.ui, fmt = App.fmt;
  var SCALE = [[90, 'A+'], [80, 'A'], [70, 'B+'], [60, 'B'], [50, 'C'], [40, 'D'], [0, 'F']];
  function gradeOf(p) { for (var i = 0; i < SCALE.length; i++) if (p >= SCALE[i][0]) return SCALE[i][1]; return 'F'; }

  App.pages.results = {
    render: function (root, params, token) {
      var role = App.state.user.role;
      if (role === 'STUDENT') return studentView(root, token);
      var isAdmin = role === 'ADMIN';
      root.innerHTML = ui.pageHead('Results', 'Enter exam marks. Percentage and grade are calculated automatically.') +
        (isAdmin ? '<div class="tabs" role="tablist"><button type="button" class="tab" role="tab" data-tab="enter" aria-selected="true">Enter marks</button><button type="button" class="tab" role="tab" data-tab="all" aria-selected="false">All results</button></div>' : '') + '<div id="rbody">' + ui.skeleton(4) + '</div>';
      return App.batches().then(function (all) {
        if (!App.stillHere(token)) return;
        var batches = all.filter(function (b) { return b.status === 'ACTIVE'; });
        function show(tab) {
          $$('.tab', root).forEach(function (t) { t.setAttribute('aria-selected', t.dataset.tab === tab); });
          if (tab === 'all') browse($('#rbody'), all); else enter($('#rbody'), batches);
        }
        if (isAdmin) root.querySelector('.tabs').onclick = function (e) { var t = e.target.closest('[data-tab]'); if (t) show(t.dataset.tab); };
        show('enter');
      });
    }
  };

  /* ------------------------------------------------------ enter marks */
  function enter(box, batches) {
    if (!batches.length) { box.innerHTML = '<div class="card">' + ui.empty({ icon: 'layers', title: 'No active batches', text: 'You need at least one active batch to enter results.' }) + '</div>'; return; }
    box.innerHTML = '<div class="card card-pad"><div class="form-grid" style="grid-template-columns:repeat(3,minmax(0,1fr))">' +
      ui.field({ id: 'rs-batch', name: 'rs-batch', label: 'Batch', type: 'select', options: App.batchOptions(batches) }) +
      '<div class="field"><label for="rs-exam">Exam name</label><input class="input" id="rs-exam" maxlength="60" placeholder="e.g. Unit Test 1" list="rs-exams" autocomplete="off"><datalist id="rs-exams"></datalist></div>' +
      ui.field({ id: 'rs-max', name: 'rs-max', label: 'Maximum marks', type: 'number', min: 1, step: '0.5', placeholder: 'e.g. 25' }) + '</div>' +
      '<div class="row" style="margin-top:14px"><button type="button" class="btn" id="rs-open">' + icon('edit') + ' Open marks sheet</button></div><div id="rs-known" style="margin-top:12px"></div></div><div id="rs-sheet" style="margin-top:16px"></div>';
    var known = [];
    function loadExams() {
      var b = $('#rs-batch').value;
      App.api('results.exams', { batch: b }).then(function (d) {
        known = d.items;
        $('#rs-exams').innerHTML = d.items.map(function (x) { return '<option value="' + esc(x.exam) + '">'; }).join('');
        $('#rs-known').innerHTML = d.items.length ? '<span class="small muted">Existing exams for this batch (click to edit): </span>' + d.items.map(function (x, i) { return '<button type="button" class="tag" style="border:0;cursor:pointer" data-k="' + i + '">' + esc(x.exam) + ' \u00B7 ' + x.students + ' entered</button>'; }).join(' ') : '';
      }).catch(App.fail);
    }
    $('#rs-batch').onchange = function () { $('#rs-sheet').innerHTML = ''; loadExams(); };
    $('#rs-known').onclick = function (e) { var k = e.target.closest('[data-k]'); if (k) { var x = known[+k.dataset.k]; $('#rs-exam').value = x.exam; $('#rs-max').value = x.maxMarks; openSheet(); } };
    $('#rs-open').onclick = openSheet;

    function openSheet() {
      var b = $('#rs-batch').value, exam = $('#rs-exam').value.trim(), sh = $('#rs-sheet');
      if (exam.length < 2) { ui.toast('Please type the exam name first.', 'error'); $('#rs-exam').focus(); return; }
      sh.innerHTML = '<div class="card card-pad">' + ui.skeleton(6) + '</div>';
      App.api('results.sheet', { batch: b, exam: exam }).then(function (d) {
        if (d.maxMarks && !$('#rs-max').value) $('#rs-max').value = d.maxMarks;
        if (!d.students.length) { sh.innerHTML = '<div class="card">' + ui.empty({ icon: 'users', title: 'No students in this batch' }) + '</div>'; return; }
        sh.innerHTML = '<section class="card" aria-label="Marks sheet"><div class="card-head"><div><h3>' + esc(d.batch) + ' \u00B7 ' + esc(d.subject) + '</h3><div class="xs muted">' + esc(exam) + (d.exists ? ' \u2014 editing saved marks' : ' \u2014 new exam') + '</div></div></div><div>' +
          d.students.map(function (s, i) {
            return '<div class="att-row" data-i="' + i + '"><div class="who"><div class="bold">' + esc(s.name) + '</div><div class="xs muted">' + esc(s.studentId) + '</div></div>' +
              '<div><input class="input" style="width:110px" type="number" min="0" step="0.5" inputmode="decimal" data-marks placeholder="Marks" aria-label="Marks for ' + esc(s.name) + '" value="' + esc(s.marks) + '"></div>' +
              '<div style="min-width:96px" data-calc></div><div class="grow" style="min-width:140px"><input class="input" data-rem maxlength="80" placeholder="Remarks (optional)" aria-label="Remarks for ' + esc(s.name) + '" value="' + esc(s.remarks) + '"></div></div>';
          }).join('') + '</div><div class="sticky-bar"><span class="small muted" id="rs-note">Leave marks empty for absent students.</span><button type="button" class="btn" id="rs-save">' + icon('check-circle') + ' Save results</button></div></section>';
        function calc() {
          var max = Number($('#rs-max').value);
          $$('.att-row', sh).forEach(function (row) {
            var v = $('[data-marks]', row).value, c = $('[data-calc]', row);
            if (v === '' || !max) { c.innerHTML = ''; return; }
            var p = Math.round(Number(v) * 10000 / max) / 100;
            c.innerHTML = Number(v) > max ? '<span class="badge error">Above max</span>' : '<b>' + p + '%</b> ' + ui.grade(gradeOf(p));
          });
        }
        sh.addEventListener('input', calc); $('#rs-max').oninput = calc; calc();
        $('#rs-save').onclick = function () {
          var max = $('#rs-max').value;
          if (!max || Number(max) <= 0) { ui.toast('Please enter the maximum marks.', 'error'); $('#rs-max').focus(); return; }
          var entries = $$('.att-row', sh).map(function (row) { return { studentId: d.students[+row.dataset.i].studentId, marks: $('[data-marks]', row).value, remarks: $('[data-rem]', row).value }; });
          ui.busy($('#rs-save'), App.api('results.save', { batch: b, exam: exam, maxMarks: max, entries: entries })).then(function (r) {
            ui.toast('Results saved for ' + r.saved + ' student' + (r.saved === 1 ? '' : 's') + '.', 'success'); loadExams();
          }).catch(App.fail);
        };
      }).catch(function (e) { sh.innerHTML = '<div class="card">' + ui.empty({ icon: 'alert', title: 'Could not open the marks sheet', text: e.message }) + '</div>'; App.fail(e); });
    }
    loadExams();
  }

  /* ---------------------------------------------------- admin browser */
  function browse(box, all) {
    box.innerHTML = '<div id="rl"></div>';
    ui.dataList({
      root: $('#rl'), pageSize: 25, fetch: function (p) { return App.api('results.list', p); },
      filters: [{ key: 'q', type: 'search', placeholder: 'Search student name or ID' }, { key: 'exam', type: 'search', placeholder: 'Exam name' }, { key: 'batch', type: 'select', placeholder: 'All batches', options: App.batchOptions(all) }],
      empty: { icon: 'award', title: 'No results found', text: 'Teachers enter results from the "Enter marks" tab.' },
      columns: [
        { label: 'Student', render: function (r) { return '<b>' + esc(r.studentName) + '</b><div class="xs muted">' + esc(r.studentId) + '</div>'; } },
        { label: 'Exam', render: function (r) { return esc(r.exam); } }, { label: 'Batch', render: function (r) { return '<span class="tag">' + esc(r.batch) + '</span>'; } },
        { label: 'Subject', render: function (r) { return esc(r.subject); } },
        { label: 'Marks', cls: 'num', render: function (r) { return r.marks + ' / ' + r.maxMarks; } },
        { label: '%', cls: 'num', render: function (r) { return r.percentage + '%'; } }, { label: 'Grade', render: function (r) { return ui.grade(r.grade); } },
        { label: '', actions: true, render: function (r, i) { return ui.act('del', i, 'trash', 'Delete'); } }],
      onAction: function (act, r, c) {
        ui.confirm({ title: 'Delete result', danger: true, confirmText: 'Delete', message: 'Delete ' + r.studentName + '\u2019s result for "' + r.exam + '" (' + r.subject + ')?' }).then(function (ok) {
          if (ok) App.api('results.remove', { batch: r.batch, exam: r.exam, studentId: r.studentId }).then(function () { ui.toast('Result deleted.', 'success'); c.reload(); }).catch(App.fail);
        });
      }
    });
  }

  /* ------------------------------------------------------------ student */
  function studentView(root, token) {
    root.innerHTML = ui.pageHead('My results', 'Your exam results and grades.') + '<div id="mr">' + ui.skeleton(5) + '</div>';
    return App.api('results.my').then(function (d) {
      if (!App.stillHere(token)) return;
      $('#mr').innerHTML = d.items.length ? '<div class="stack-lg">' + d.items.map(function (x) {
        return '<section class="card" aria-label="' + esc(x.exam) + '"><div class="card-head"><div><h3>' + esc(x.exam) + '</h3><div class="xs muted">' + fmt.date(x.date) + '</div></div>' +
          '<div class="row"><div class="right"><div class="bold">' + fmt.num(x.total) + ' / ' + fmt.num(x.maxTotal) + '</div><div class="xs muted">Total marks</div></div><div class="right"><div class="bold">' + x.percentage + '%</div><div class="xs muted">Percentage</div></div>' + ui.grade(x.grade) + '</div></div>' +
          '<div style="padding:0">' + ui.table([{ label: 'Subject', render: function (s) { return '<b>' + esc(s.subject) + '</b>'; } }, { label: 'Marks', cls: 'num', render: function (s) { return s.marks + ' / ' + s.maxMarks; } },
            { label: '%', cls: 'num', render: function (s) { return s.percentage + '%'; } }, { label: 'Grade', render: function (s) { return ui.grade(s.grade); } }, { label: 'Remarks', render: function (s) { return esc(s.remarks || '\u2014'); } }], x.subjects).replace('class="table-wrap"', 'class="table-wrap" style="border:0;box-shadow:none;border-radius:0"') + '</div></section>';
      }).join('') + '</div>' : '<div class="card">' + ui.empty({ icon: 'award', title: 'No results yet', text: 'Your results will appear here once your teachers publish them.' }) + '</div>';
    });
  }
})();
</script>
  <script>
/* Js_Fees — admin: dues, payments, fee assignment, receipts. Student: own fees & receipts. */
(function () {
  'use strict';
  var App = window.App, $ = App.$, $$ = App.$$, esc = App.esc, icon = App.icon, ui = App.ui, fmt = App.fmt;
  var MODES = [{ value: 'CASH', label: 'Cash' }, { value: 'UPI', label: 'UPI' }, { value: 'CARD', label: 'Card' }, { value: 'BANK_TRANSFER', label: 'Bank transfer' }, { value: 'CHEQUE', label: 'Cheque' }];
  function modeLabel(m) { return String(m).replace('_', ' ').toLowerCase().replace(/^\w/, function (c) { return c.toUpperCase(); }); }
  function who(name, id) { return '<div class="bold">' + esc(name) + '</div><div class="xs muted">' + esc(id) + '</div>'; }

  App.pages.fees = {
    render: function (root, params, token) {
      if (App.state.user.role === 'STUDENT') return studentView(root, token);
      root.innerHTML = ui.pageHead('Fees & payments', 'Track dues, record payments and issue receipts.',
        '<button type="button" class="btn secondary" id="asg-fee">' + icon('plus') + ' Assign fees</button><button type="button" class="btn" id="rec-pay">' + icon('credit-card') + ' Record payment</button>') +
        '<div class="tabs" role="tablist"><button type="button" class="tab" role="tab" data-tab="dues" aria-selected="true">Fees & dues</button><button type="button" class="tab" role="tab" data-tab="pays" aria-selected="false">Payment history</button></div><div id="fbody"></div>';
      var view = null;
      function show(tab) {
        $$('.tab', root).forEach(function (t) { t.setAttribute('aria-selected', t.dataset.tab === tab); });
        view = tab === 'dues' ? dues($('#fbody')) : payments($('#fbody'));
      }
      function refresh() { if (view) view.reload(); }
      root.querySelector('.tabs').onclick = function (e) { var t = e.target.closest('[data-tab]'); if (t) show(t.dataset.tab); };
      $('#asg-fee').onclick = function () { assignDialog(refresh); };
      $('#rec-pay').onclick = function () { paymentDialog(null, refresh); };
      return App.batches().then(function (b) {
        if (!App.stillHere(token)) return;
        App.state.cache.batches = b; show('dues');
        if (params && params.student) studentDialog(params.student, refresh);
      });
    }
  };

  /* ------------------------------------------------------------ dues */
  function dues(box) {
    box.innerHTML = '<div id="dues-tot"></div><div id="dl"></div>';
    var ftLoaded = false;
    return ui.dataList({
      root: $('#dl'), pageSize: 25, fetch: function (p) { return App.api('fees.outstanding', p); },
      filters: [{ key: 'q', type: 'search', placeholder: 'Search student name or ID' },
        { key: 'status', type: 'select', placeholder: 'Any status', value: 'DUE', options: [{ value: 'DUE', label: 'With balance due' }, { value: 'PENDING', label: 'Unpaid' }, { value: 'PARTIAL', label: 'Partly paid' }, { value: 'PAID', label: 'Fully paid' }, { value: 'ALL', label: 'All fees' }] },
        { key: 'class', type: 'select', placeholder: 'All classes', options: (App.state.info.classes || []).map(function (c) { return { value: c, label: 'Class ' + c }; }) },
        { key: 'batch', type: 'select', placeholder: 'All batches', options: App.batchOptions(App.state.cache.batches || []) },
        { key: 'feeType', type: 'select', placeholder: 'All fee types', options: [] }],
      empty: { icon: 'rupee', title: 'No fee records found', text: 'Use "Assign fees" to add fees to a student, batch or class.' },
      onLoad: function (d, ctrl) {
        var t = d.totals;
        $('#dues-tot').innerHTML = '<div class="grid c3" style="margin-bottom:16px">' + ui.stat('rupee', fmt.money(t.remaining), 'Balance due (' + t.count + ' records)', 'error') + ui.stat('check-circle', fmt.money(t.paid), 'Collected', 'success') + ui.stat('file', fmt.money(t.finalFee), 'Total after discounts') + '</div>';
        if (!ftLoaded && d.feeTypes.length) {
          ftLoaded = true; var sel = $('[data-f=feeType]', ctrl.root);
          if (sel) sel.innerHTML = ui.opts(d.feeTypes, '', 'All fee types');
        }
      },
      columns: [
        { label: 'Student', render: function (f) { return who(f.studentName, f.studentId); } }, { label: 'Class', render: function (f) { return esc(f.class); } },
        { label: 'Fee', render: function (f) { return esc(f.feeType); } },
        { label: 'Final fee', cls: 'num', render: function (f) { return fmt.money(f.finalFee); } }, { label: 'Paid', cls: 'num', render: function (f) { return fmt.money(f.paid); } },
        { label: 'Balance', cls: 'num', render: function (f) { return '<b style="color:' + (f.remaining > 0 ? 'var(--error)' : 'var(--success)') + '">' + fmt.money(f.remaining) + '</b>'; } },
        { label: 'Due date', render: function (f) { return f.dueDate ? fmt.date(f.dueDate) + (f.overdue ? ' ' + ui.badge('Overdue', 'error') : '') : '\u2014'; } },
        { label: 'Status', render: function (f) { return ui.feeStatus(f.status); } },
        { label: '', actions: true, render: function (f, i) { return (f.remaining > 0 ? ui.act('pay', i, 'credit-card', 'Pay', '') : '') + ui.act('open', i, 'eye', 'Details'); } }],
      onAction: function (act, f, ctrl) {
        if (act === 'pay') paymentDialog({ student: { studentId: f.studentId, name: f.studentName, class: f.class }, feeType: f.feeType }, ctrl.reload);
        else studentDialog({ studentId: f.studentId, name: f.studentName, class: f.class }, ctrl.reload);
      }
    });
  }

  /* -------------------------------------------------------- payments */
  function payments(box) {
    box.innerHTML = '<div id="pay-tot"></div><div id="pl"></div>';
    return ui.dataList({
      root: $('#pl'), pageSize: 25, fetch: function (p) { return App.api('payments.list', p); },
      filters: [{ key: 'q', type: 'search', placeholder: 'Search student, receipt no.' }, { key: 'mode', type: 'select', placeholder: 'All modes', options: MODES },
        { key: 'from', type: 'date', placeholder: 'From' }, { key: 'to', type: 'date', placeholder: 'To' }],
      empty: { icon: 'receipt', title: 'No payments found', text: 'Recorded payments and their receipts will be listed here.' },
      onLoad: function (d) { $('#pay-tot').innerHTML = '<div class="alert info" style="margin-bottom:14px">' + icon('info') + '<div><b>' + fmt.money(d.totalAmount) + '</b> in ' + d.total + ' payment' + (d.total === 1 ? '' : 's') + ' for the current filters.</div></div>'; },
      columns: [
        { label: 'Date', render: function (p) { return fmt.date(p.date); } }, { label: 'Receipt', render: function (p) { return '<span class="tag">' + esc(p.receiptNumber) + '</span>'; } },
        { label: 'Student', render: function (p) { return who(p.studentName, p.studentId); } }, { label: 'Fee', render: function (p) { return esc(p.feeType); } },
        { label: 'Amount', cls: 'num', render: function (p) { return '<b>' + fmt.money(p.amount) + '</b>'; } }, { label: 'Mode', render: function (p) { return esc(modeLabel(p.mode)); } },
        { label: 'Balance after', cls: 'num', render: function (p) { return fmt.money(p.remainingBalance); } },
        { label: '', actions: true, render: function (p, i) { return ui.act('rc', i, 'download', 'Receipt'); } }],
      onAction: function (act, p, c, btn) { App.download(btn, 'receipts.get', { paymentId: p.paymentId }); }
    });
  }

  /* --------------------------------------------- student fee details */
  function studentDialog(stu, onChange) {
    var m = ui.modal({ title: 'Fees \u2014 ' + stu.name, size: 'lg', body: ui.skeleton(5), footer: '<button type="button" class="btn secondary" id="sd-add">' + icon('plus') + ' Assign another fee</button><button type="button" class="btn" data-close>Close</button>' });
    function load() {
      m.body.innerHTML = ui.skeleton(5);
      App.api('fees.student', { studentId: stu.studentId }).then(function (d) {
        var t = d.totals;
        m.body.innerHTML = '<div class="row between" style="margin-bottom:14px"><div class="row nowrapflex">' + ui.avatar(d.student.name) + '<div>' + who(d.student.name, d.student.studentId + ' \u00B7 Class ' + d.student.class) + '</div></div>' +
          '<div class="row"><span class="badge">Fees ' + fmt.money(t.finalFee) + '</span><span class="badge success">Paid ' + fmt.money(t.paid) + '</span><span class="badge ' + (t.remaining > 0 ? 'error' : 'success') + '">Balance ' + fmt.money(t.remaining) + '</span></div></div>' +
          '<h3 style="margin-bottom:8px">Fee records</h3>' + (d.fees.length ? ui.table([
            { label: 'Fee', render: function (f) { return '<b>' + esc(f.feeType) + '</b>' + (f.dueDate ? '<div class="xs muted">Due ' + fmt.date(f.dueDate) + (f.overdue ? ' \u00B7 overdue' : '') + '</div>' : ''); } },
            { label: 'Total', cls: 'num', render: function (f) { return fmt.money(f.totalFee); } }, { label: 'Discount', cls: 'num', render: function (f) { return fmt.money(f.discount); } },
            { label: 'Paid', cls: 'num', render: function (f) { return fmt.money(f.paid); } }, { label: 'Balance', cls: 'num', render: function (f) { return '<b>' + fmt.money(f.remaining) + '</b>'; } },
            { label: 'Status', render: function (f) { return ui.feeStatus(f.status); } },
            { label: '', actions: true, render: function (f, i) { return (f.remaining > 0 ? ui.act('pay', i, 'credit-card', 'Pay', '') : '') + ui.act('edit', i, 'edit', 'Edit') + (f.paid === 0 ? ui.act('del', i, 'trash', 'Delete') : ''); } }], d.fees) : '<p class="muted small">No fees assigned yet.</p>') +
          '<h3 style="margin:18px 0 8px">Payment history</h3>' + (d.payments.length ? ui.table([
            { label: 'Date', render: function (p) { return fmt.date(p.date); } }, { label: 'Receipt', render: function (p) { return '<span class="tag">' + esc(p.receiptNumber) + '</span>'; } },
            { label: 'Fee', render: function (p) { return esc(p.feeType); } }, { label: 'Amount', cls: 'num', render: function (p) { return '<b>' + fmt.money(p.amount) + '</b>'; } },
            { label: 'Mode', render: function (p) { return esc(modeLabel(p.mode)); } }, { label: '', actions: true, render: function (p, i) { return ui.act('rc', i, 'download', 'Receipt'); } }], d.payments) : '<p class="muted small">No payments yet.</p>');
        var tables = m.body.querySelectorAll('.table-wrap');
        var ft = d.fees.length ? tables[0] : null, pt = d.payments.length ? tables[d.fees.length ? 1 : 0] : null;
        if (ft) ft.onclick = function (e) {
          var a = e.target.closest('[data-act]'); if (!a) return; var f = d.fees[+a.dataset.i];
          if (a.dataset.act === 'pay') paymentDialog({ student: stu, feeType: f.feeType }, function () { load(); onChange && onChange(); });
          else if (a.dataset.act === 'edit') feeEditDialog(f, function () { load(); onChange && onChange(); });
          else ui.confirm({ title: 'Delete fee', danger: true, confirmText: 'Delete', message: 'Delete "' + f.feeType + '" for this student? This cannot be undone.' }).then(function (ok) {
            if (ok) App.api('fees.remove', { studentId: f.studentId, feeType: f.feeType }).then(function () { ui.toast('Fee deleted.', 'success'); load(); onChange && onChange(); }).catch(App.fail);
          });
        };
        if (pt) pt.onclick = function (e) { var a = e.target.closest('[data-act]'); if (a) App.download(a, 'receipts.get', { paymentId: d.payments[+a.dataset.i].paymentId }); };
      }).catch(function (e) { m.body.innerHTML = '<div class="alert error">' + esc(e.message) + '</div>'; });
    }
    $('#sd-add', m.el).onclick = function () { assignDialog(function () { load(); onChange && onChange(); }, stu); };
    load();
  }

  function feeEditDialog(f, done) {
    ui.formModal({
      title: 'Edit fee \u2014 ' + f.feeType, submitText: 'Save changes', size: 'sm',
      intro: f.paid > 0 ? 'Already paid: <b>' + fmt.money(f.paid) + '</b>. The final fee cannot go below this amount.' : '',
      fields: [{ name: 'totalFee', label: 'Total fee (\u20B9)', type: 'number', required: true, min: 1, step: '0.01', value: f.totalFee, full: true },
        { name: 'discount', label: 'Discount (\u20B9)', type: 'number', min: 0, step: '0.01', value: f.discount, full: true },
        { name: 'dueDate', label: 'Due date (optional)', type: 'date', value: f.dueDate, full: true }],
      onSubmit: function (d) { return App.api('fees.update', Object.assign({ studentId: f.studentId, feeType: f.feeType }, d)).then(function () { ui.toast('Fee updated.', 'success'); done(); }); }
    });
  }

  /* ------------------------------------------------- assign fees dialog */
  function assignDialog(done, stu) {
    var month = new Date().toLocaleString('en', { month: 'short' }) + ' ' + new Date().getFullYear();
    var ay = App.state.info.academicYear || '';
    var picked = stu || null;
    ui.formModal({
      title: 'Assign fees', submitText: 'Assign fees', size: 'lg',
      intro: 'Fees already assigned with the same fee type are skipped, so it is safe to run this again for a batch or class.',
      fields: [
        { name: 'ttype', label: 'Assign to', type: 'select', required: true, value: stu ? 'STUDENT' : 'CLASS', options: [{ value: 'CLASS', label: 'A whole class' }, { value: 'BATCH', label: 'A batch' }, { value: 'STUDENT', label: 'One student' }] },
        { name: 'tval', label: 'Class', type: 'select', required: true, options: [] },
        { name: 'feeType', label: 'Fee type', required: true, attrs: 'list="fee-types" maxlength="60" autocomplete="off"', placeholder: 'e.g. Course Fee ' + ay, help: 'Choose a suggestion or type your own name.' },
        { name: 'totalFee', label: 'Total fee (\u20B9)', type: 'number', required: true, min: 1, step: '0.01' },
        { name: 'discount', label: 'Discount (\u20B9)', type: 'number', min: 0, step: '0.01', value: 0 },
        { name: 'dueDate', label: 'Due date (optional)', type: 'date' }
      ],
      after: '<datalist id="fee-types"><option value="Course Fee ' + esc(ay) + '"><option value="Monthly Fee - ' + esc(month) + '"><option value="Admission Fee"><option value="Exam Fee"></datalist>',
      onOpen: function (m, form) {
        var tt = $('[name=ttype]', form), tv = $('[name=tval]', form), holder = tv.closest('.field');
        function swap() {
          var t = tt.value;
          if (t === 'STUDENT') {
            holder.innerHTML = '<span class="lbl">Student</span><div id="as-pick"></div>';
            ui.studentPicker($('#as-pick', holder), function (s) { picked = s; }, picked);
          } else {
            holder.innerHTML = '<label for="f-tval">' + (t === 'CLASS' ? 'Class' : 'Batch') + ' <span class="req">*</span></label><select class="select" id="f-tval" name="tval" required>' +
              ui.opts(t === 'CLASS' ? (App.state.info.classes || []).map(function (c) { return { value: c, label: 'Class ' + c }; }) : App.batchOptions(App.state.cache.batches || [], true), '', 'Select\u2026') + '</select>';
          }
        }
        tt.addEventListener('change', swap); swap();
      },
      onSubmit: function (d) {
        var t = d.ttype, value = t === 'STUDENT' ? (picked && picked.studentId) : d.tval;
        if (!value) return Promise.reject({ message: t === 'STUDENT' ? 'Please choose a student.' : 'Please make a selection to assign the fee to.' });
        return App.api('fees.assign', { target: { type: t, value: value }, feeType: d.feeType, totalFee: d.totalFee, discount: d.discount || 0, dueDate: d.dueDate })
          .then(function (r) { ui.toast(r.created + ' fee record' + (r.created === 1 ? '' : 's') + ' created' + (r.skipped ? ', ' + r.skipped + ' skipped (already assigned)' : '') + '.', 'success'); done(); });
      }
    });
  }

  /* ---------------------------------------------------- record payment */
  function paymentDialog(pre, done) {
    var chosen = pre ? pre.student : null, fees = [];
    var m = ui.formModal({
      title: 'Record payment', submitText: 'Record payment', size: 'lg',
      fields: [
        { name: 'feeType', label: 'Fee', type: 'select', required: true, blank: 'Choose a student first', options: [] },
        { name: 'amount', label: 'Amount received (\u20B9)', type: 'number', required: true, min: 1, step: '0.01' },
        { name: 'date', label: 'Payment date', type: 'date', required: true, value: fmt.today(), max: fmt.today() },
        { name: 'paymentMode', label: 'Payment mode', type: 'select', required: true, options: MODES, value: 'CASH' },
        { name: 'notes', label: 'Notes (optional)', full: true, attrs: 'maxlength="200"', placeholder: 'e.g. UPI reference, cheque number' }
      ],
      after: '<div id="pay-info" class="small muted" style="margin-top:10px"></div>',
      onOpen: function (mm, form) {
        form.insertAdjacentHTML('afterbegin', '<div class="field full"><span class="lbl">Student <span class="req">*</span></span><div id="pay-pick"></div></div>');
        var sel = $('[name=feeType]', form), amt = $('[name=amount]', form);
        function loadFees(first) {
          if (!chosen) { sel.innerHTML = '<option value="">Choose a student first</option>'; return; }
          sel.innerHTML = '<option value="">Loading\u2026</option>';
          App.api('fees.student', { studentId: chosen.studentId }).then(function (d) {
            fees = d.fees.filter(function (f) { return f.remaining > 0; });
            sel.innerHTML = fees.length ? ui.opts(fees.map(function (f) { return { value: f.feeType, label: f.feeType + ' \u2014 balance ' + fmt.money(f.remaining) }; }), first && pre && pre.feeType ? pre.feeType : (fees.length === 1 ? fees[0].feeType : ''), 'Select fee') : '<option value="">No fees with a balance</option>';
            sel.dispatchEvent(new Event('change'));
          }).catch(function (e) { sel.innerHTML = '<option value="">Could not load fees</option>'; App.fail(e); });
        }
        sel.addEventListener('change', function () {
          var f = fees.filter(function (x) { return x.feeType === sel.value; })[0], info = $('#pay-info', mm.el);
          if (f) { amt.max = f.remaining; amt.value = f.remaining; info.innerHTML = 'Balance before this payment: <b>' + fmt.money(f.remaining) + '</b>. Partial payments (installments) are allowed.'; }
          else info.innerHTML = '';
        });
        ui.studentPicker($('#pay-pick', form), function (s) { chosen = s; loadFees(false); }, chosen);
        if (chosen) loadFees(true);
      },
      onSubmit: function (d) {
        if (!chosen) return Promise.reject({ message: 'Please choose a student.' });
        return App.api('payments.record', { studentId: chosen.studentId, feeType: d.feeType, amount: d.amount, date: d.date, paymentMode: d.paymentMode, notes: d.notes }).then(function (r) {
          done && done();
          var rm = ui.modal({ title: 'Payment recorded', size: 'sm', body: '<div class="center"><div class="empty" style="padding:0 0 8px"><div class="ico" style="background:var(--success-50);color:var(--success)">' + icon('check-circle') + '</div></div><h3>' + fmt.money(d.amount) + ' received</h3><p class="small muted" style="margin:4px 0 12px">Receipt no. <b>' + esc(r.receiptNumber) + '</b><br>Remaining balance: ' + fmt.money(r.remaining) + '</p>' + (r.receiptReady ? '' : '<p class="xs muted">The PDF is being prepared and will be created when you open it.</p>') + '</div>',
            footer: '<button type="button" class="btn secondary" data-close>Close</button><button type="button" class="btn" id="rc-dl">' + icon('download') + ' Download receipt</button>' });
          $('#rc-dl', rm.el).onclick = function () { App.download(this, 'receipts.get', { paymentId: r.paymentId }); };
        });
      }
    });
  }

  /* ---------------------------------------------------------- student */
  function studentView(root, token) {
    root.innerHTML = ui.pageHead('My fees', 'Your fees, payments and receipts.') + '<div id="mf">' + ui.skeleton(5) + '</div>';
    return App.api('fees.my').then(function (d) {
      if (!App.stillHere(token)) return;
      var t = d.totals;
      $('#mf').innerHTML = '<div class="stack-lg"><div class="grid c3">' + ui.stat('file', fmt.money(t.finalFee), 'Total fees') + ui.stat('check-circle', fmt.money(t.paid), 'Paid', 'success') + ui.stat('rupee', fmt.money(t.remaining), 'Remaining', t.remaining > 0 ? 'error' : 'success') + '</div>' +
        '<section><h2 style="margin-bottom:10px">Fee details</h2>' + (d.fees.length ? '<div class="grid c2">' + d.fees.map(function (f) {
          var pct = f.finalFee ? Math.round(f.paid * 100 / f.finalFee) : 100;
          return '<article class="card card-pad stack"><div class="row between"><h3>' + esc(f.feeType) + '</h3>' + ui.feeStatus(f.status) + '</div>' +
            '<dl class="kv"><dt>Total fee</dt><dd>' + fmt.money(f.totalFee) + '</dd>' + (f.discount ? '<dt>Discount</dt><dd>\u2212 ' + fmt.money(f.discount) + '</dd>' : '') + '<dt>Payable</dt><dd>' + fmt.money(f.finalFee) + '</dd><dt>Paid</dt><dd>' + fmt.money(f.paid) + '</dd><dt>Remaining</dt><dd><b>' + fmt.money(f.remaining) + '</b></dd>' + (f.dueDate ? '<dt>Due date</dt><dd>' + fmt.date(f.dueDate) + (f.overdue ? ' ' + ui.badge('Overdue', 'error') : '') + '</dd>' : '') + '</dl>' + ui.progress(pct, pct >= 100 ? 'success' : '') + '</article>';
        }).join('') + '</div>' : '<div class="card">' + ui.empty({ icon: 'rupee', title: 'No fees assigned yet', text: 'Fees added by the institute will show here.' }) + '</div>') + '</section>' +
        '<section><h2 style="margin-bottom:10px">Payment history</h2>' + (d.payments.length ? ui.table([
          { label: 'Date', render: function (p) { return fmt.date(p.date); } }, { label: 'Receipt no.', render: function (p) { return '<span class="tag">' + esc(p.receiptNumber) + '</span>'; } },
          { label: 'Fee', render: function (p) { return esc(p.feeType); } }, { label: 'Amount', cls: 'num', render: function (p) { return '<b>' + fmt.money(p.amount) + '</b>'; } },
          { label: 'Mode', render: function (p) { return esc(modeLabel(p.mode)); } }, { label: 'Balance after', cls: 'num', render: function (p) { return fmt.money(p.remainingBalance); } },
          { label: '', actions: true, render: function (p, i) { return ui.act('rc', i, 'download', 'Receipt'); } }], d.payments) : '<div class="card">' + ui.empty({ icon: 'receipt', title: 'No payments yet' }) + '</div>') + '</section></div>';
      var tbl = $('#mf .table-wrap');
      if (tbl && d.payments.length) tbl.onclick = function (e) { var a = e.target.closest('[data-act]'); if (a) App.download(a, 'receipts.get', { paymentId: d.payments[+a.dataset.i].paymentId }); };
    });
  }
})();
</script>
  <script>
/* Js_Misc — Notifications, Timetable, Settings */
(function () {
  'use strict';
  var App = window.App, $ = App.$, $$ = App.$$, esc = App.esc, icon = App.icon, ui = App.ui, fmt = App.fmt;

  /* ============================================================ NOTIFICATIONS */
  App.pages.notifications = {
    render: function (root, params, token) {
      var isAdmin = App.state.user.role === 'ADMIN', page = 1, items = [];
      root.innerHTML = ui.pageHead('Notifications', isAdmin ? 'Messages sent to students and teachers.' : 'Updates from the institute and your teachers.',
        isAdmin ? '<button type="button" class="btn" id="send-n">' + icon('send') + ' Send notification</button>' : '<button type="button" class="btn secondary" id="read-all">' + icon('check') + ' Mark all as read</button>') + '<div id="nl">' + ui.skeleton(5) + '</div>';
      function paint(d) {
        var html = items.length ? '<ul class="card list">' + items.map(function (n, i) {
          return '<li class="list-item" style="align-items:flex-start' + (n.unread ? ';background:var(--primary-50)' : '') + '"><div class="avatar" style="' + (n.unread ? '' : 'background:#eef2f7;color:var(--muted)') + '">' + icon('bell') + '</div>' +
            '<div class="grow"><div class="row between nowrapflex" style="align-items:flex-start"><div class="' + (n.unread ? 'bold' : 'bold') + '">' + esc(n.title) + (n.unread ? ' ' + ui.badge('New', 'primary') : '') + '</div><span class="xs muted nowrap">' + esc(fmt.dateTime(n.date)) + '</span></div>' +
            '<div class="small" style="white-space:pre-line;margin-top:2px">' + esc(n.message) + '</div>' +
            '<div class="xs muted" style="margin-top:4px">' + (isAdmin ? 'To: ' + esc(n.target === 'ALL' ? 'Everyone' : n.target.replace('CLASS_', 'Class ')) : (n.from ? 'From ' + esc(n.from) : '')) + '</div></div>' +
            (isAdmin ? '<button type="button" class="btn ghost sm icon-only" data-del="' + i + '" aria-label="Delete notification">' + icon('trash') + '</button>' : '') + '</li>';
        }).join('') + '</ul>' + (d.page < d.pages ? '<div class="center" style="margin-top:14px"><button type="button" class="btn secondary" id="more-n">Load more</button></div>' : '')
          : '<div class="card">' + ui.empty({ icon: 'bell', title: 'No notifications', text: isAdmin ? 'Use "Send notification" to message students.' : 'You are all caught up.' }) + '</div>';
        $('#nl').innerHTML = html;
        var more = $('#more-n'); if (more) more.onclick = function () { page++; load(true); };
      }
      function load(append) {
        return App.api('notifications.list', { page: page, pageSize: 20 }).then(function (d) {
          if (!App.stillHere(token)) return;
          items = append ? items.concat(d.items) : d.items;
          if (!isAdmin) { App.setUnread(d.unread); App.state.user.unread = d.unread; }
          paint(d);
        });
      }
      $('#nl').onclick = function (e) {
        var del = e.target.closest('[data-del]'); if (!del) return; var n = items[+del.dataset.del];
        ui.confirm({ title: 'Delete notification', danger: true, confirmText: 'Delete', message: 'Delete "' + n.title + '" for everyone?' }).then(function (ok) {
          if (ok) App.api('notifications.remove', { id: n.id }).then(function () { ui.toast('Notification deleted.', 'success'); page = 1; load(); }).catch(App.fail);
        });
      };
      if (isAdmin) $('#send-n').onclick = function () { sendDialog(function () { page = 1; load(); }); };
      else $('#read-all').onclick = function () {
        ui.busy(this, App.api('notifications.markRead')).then(function () { items.forEach(function (n) { n.unread = false; }); App.setUnread(0); page = 1; load(); ui.toast('All notifications marked as read.', 'success'); }).catch(App.fail);
      };
      return load();
    }
  };

  function sendDialog(done) {
    var picked = null;
    App.batches().then(function (batches) {
      var opts = [{ value: 'ALL', label: 'Everyone' }].concat((App.state.info.classes || []).map(function (c) { return { value: 'CLASS_' + c, label: 'All of Class ' + c }; }))
        .concat(batches.filter(function (b) { return b.status === 'ACTIVE'; }).map(function (b) { return { value: b.batch, label: 'Batch ' + b.batch + ' \u2014 ' + b.subject }; })).concat([{ value: '__STUDENT', label: 'One student\u2026' }]);
      ui.formModal({
        title: 'Send notification', submitText: 'Send', size: 'lg',
        fields: [
          { name: 'target', label: 'Send to', type: 'select', required: true, options: opts, full: true },
          { name: 'title', label: 'Title', required: true, full: true, attrs: 'maxlength="100"' },
          { name: 'message', label: 'Message', type: 'textarea', required: true, full: true, rows: 4, attrs: 'maxlength="500"' }
        ],
        onOpen: function (m, form) {
          var sel = $('[name=target]', form), holder = document.createElement('div');
          holder.className = 'field full hidden'; holder.innerHTML = '<span class="lbl">Student</span><div id="sn-pick"></div>';
          sel.closest('.field').after(holder);
          ui.studentPicker($('#sn-pick', holder), function (s) { picked = s; });
          sel.addEventListener('change', function () { holder.classList.toggle('hidden', sel.value !== '__STUDENT'); });
        },
        onSubmit: function (d) {
          var target = d.target;
          if (target === '__STUDENT') { if (!picked) return Promise.reject({ message: 'Please choose a student.' }); target = picked.studentId; }
          return App.api('notifications.create', { target: target, title: d.title, message: d.message }).then(function () { ui.toast('Notification sent.', 'success'); done(); });
        }
      });
    }).catch(App.fail);
  }

  /* ================================================================ TIMETABLE */
  App.pages.timetable = {
    render: function (root, params, token) {
      var role = App.state.user.role;
      root.innerHTML = ui.pageHead('Timetable', role === 'ADMIN' ? 'Weekly schedule of all active batches. Edit schedules from the Batches page.' : 'Your weekly class schedule.') + '<div id="tt">' + ui.skeleton(5) + '</div>';
      return App.api('timetable.get').then(function (d) {
        if (!App.stillHere(token)) return;
        if (!d.items.length) { $('#tt').innerHTML = '<div class="card">' + ui.empty({ icon: 'clock', title: 'No classes scheduled', text: role === 'ADMIN' ? 'Add a schedule (days and time) to your batches.' : 'Your timetable will appear once batches have schedules.' }) + '</div>'; return; }
        var order = [1, 2, 3, 4, 5, 6, 0];
        $('#tt').innerHTML = '<div class="tt">' + order.map(function (day) {
          var slots = d.items.filter(function (b) { return b.days.indexOf(day) >= 0; }).sort(function (a, b) { return a.startMin - b.startMin; });
          return '<section class="tt-col' + (day === d.today ? ' today' : '') + '" aria-label="' + fmt.days[day] + '"><h4>' + fmt.days[day] + (day === d.today ? ' \u00B7 Today' : '') + '</h4>' +
            (slots.length ? slots.map(function (b) {
              return '<div class="tt-slot"><span class="muted">' + esc(b.time || '') + '</span><b>' + esc(b.subject) + '</b>' + (role === 'STUDENT' ? esc(b.teacherName) : esc(b.batch) + (role === 'ADMIN' ? ' \u00B7 ' + esc(b.teacherName) : '')) + '</div>';
            }).join('') : '<div class="tt-slot muted">No classes</div>') + '</section>';
        }).join('') + '</div>';
      });
    }
  };

  /* ================================================================= SETTINGS */
  App.pages.settings = {
    render: function (root, params, token) {
      root.innerHTML = ui.pageHead('Settings', 'Institute details used across the portal and on receipts.') + '<div id="st">' + ui.skeleton(6) + '</div>';
      return App.api('settings.get').then(function (s) {
        if (!App.stillHere(token)) return;
        $('#st').innerHTML = '<div class="stack-lg" style="max-width:860px">' +
          '<form id="set-form" class="card card-pad stack-lg" novalidate>' +
          '<section><h2 style="margin-bottom:12px">Institute</h2><div class="form-grid">' +
          ui.field({ name: 'InstituteName', label: 'Institute name', required: true, value: s.InstituteName, full: true, attrs: 'maxlength="80"' }) +
          ui.field({ name: 'Address', label: 'Address (printed on receipts)', value: s.Address, full: true, attrs: 'maxlength="200"' }) +
          ui.field({ name: 'Phone', label: 'Phone', value: s.Phone, attrs: 'maxlength="40"' }) + ui.field({ name: 'Email', label: 'Email', type: 'email', value: s.Email, attrs: 'maxlength="80"' }) + '</div></section>' +
          '<section><h2 style="margin-bottom:12px">Academics & receipts</h2><div class="form-grid">' +
          ui.field({ name: 'AcademicYear', label: 'Academic year', required: true, value: s.AcademicYear, placeholder: '2026-27', help: 'Format: 2026-27' }) +
          ui.field({ name: 'ReceiptPrefix', label: 'Receipt number prefix', required: true, value: s.ReceiptPrefix, help: 'Receipts look like ' + esc(s.ReceiptPrefix || 'SCC') + '-2627-000001', attrs: 'maxlength="8" style="text-transform:uppercase"' }) +
          ui.field({ name: 'AllowedClasses', label: 'Classes offered', required: true, value: s.AllowedClasses, help: 'Comma separated, e.g. 8,9,10. Add 11,12 here to expand later.' }) +
          ui.field({ name: 'LowAttendanceThreshold', label: 'Low attendance warning below (%)', type: 'number', min: 1, max: 100, value: s.LowAttendanceThreshold, required: true }) + '</div></section>' +
          '<section><h2 style="margin-bottom:12px">Self-registration</h2><div class="form-grid">' +
          ui.field({ name: 'StudentRegistration', label: 'Students can register', type: 'select', options: [{ value: 'ON', label: 'On (needs your approval)' }, { value: 'OFF', label: 'Off' }], value: s.StudentRegistration }) +
          ui.field({ name: 'TeacherRegistration', label: 'Teachers can register', type: 'select', options: [{ value: 'ON', label: 'On (needs your approval)' }, { value: 'OFF', label: 'Off' }], value: s.TeacherRegistration }) + '</div></section>' +
          '<div id="set-err"></div><div class="row"><button type="submit" class="btn" id="set-save">' + icon('check-circle') + ' Save settings</button></div></form>' +
          '<section class="card card-pad"><h2 style="margin-bottom:6px">Institute logo</h2><p class="small muted" style="margin-bottom:14px">Shown on the login page, the menu and receipts. PNG or JPG, up to 300 KB (a small square image works best).</p>' +
          '<div class="row"><div class="brand" style="padding:0"><div class="logo" style="width:72px;height:72px;border:1px solid var(--border);background:#fff">' + App.logoHtml({ name: s.InstituteName, logo: s.logo }) + '</div></div>' +
          '<div class="grow"><input type="file" id="logo-file" accept="image/png,image/jpeg" aria-label="Choose logo file"></div><button type="button" class="btn secondary" id="logo-up">' + icon('upload') + ' Upload</button>' + (s.hasLogo ? '<button type="button" class="btn ghost" id="logo-rm">Remove</button>' : '') + '</div></section></div>';

        $('#set-form').onsubmit = function (e) {
          e.preventDefault(); $('#set-err').innerHTML = '';
          var d = ui.formData(this);
          ui.busy($('#set-save'), App.api('settings.save', d)).then(function () { ui.toast('Settings saved.', 'success'); return refreshInfo(); })
            .catch(function (err) { $('#set-err').innerHTML = '<div class="alert error" role="alert">' + icon('alert') + '<div>' + esc(err.message) + '</div></div>'; });
        };
        $('#logo-up').onclick = function () {
          var btn = this;
          ui.readFile($('#logo-file'), 'logo').then(function (f) {
            if (!f) { ui.toast('Please choose an image first.', 'error'); return; }
            return ui.busy(btn, App.api('settings.uploadLogo', { file: f })).then(function () { ui.toast('Logo updated.', 'success'); return refreshInfo(); });
          }).catch(App.fail);
        };
        var rm = $('#logo-rm');
        if (rm) rm.onclick = function () { ui.busy(rm, App.api('settings.removeLogo')).then(function () { ui.toast('Logo removed.', 'success'); return refreshInfo(); }).catch(App.fail); };
      });
    }
  };
  function refreshInfo() {
    return App.api('public.info').then(function (info) { App.state.info = info; App.state.cache = {}; App.renderShell(); App.go('settings'); });
  }
})();
</script>
  <script>
/* Js_App — shell (sidebar, top bar, bottom nav), role-based navigation, router, boot */
(function () {
  'use strict';
  var App = window.App, $ = App.$, $$ = App.$$, esc = App.esc, icon = App.icon, ui = App.ui;

  // [route, label, icon]
  var NAV = {
    ADMIN: [['dashboard', 'Dashboard', 'grid'], ['approvals', 'Approvals', 'user-check'], ['students', 'Students', 'users'], ['teachers', 'Teachers', 'briefcase'],
      ['batches', 'Batches', 'layers'], ['attendance', 'Attendance', 'clipboard'], ['assignments', 'Assignments', 'file'], ['materials', 'Study Material', 'book'],
      ['results', 'Results', 'award'], ['fees', 'Fees & Payments', 'rupee'], ['timetable', 'Timetable', 'clock'], ['events', 'Events', 'calendar'],
      ['notifications', 'Notifications', 'bell'], ['settings', 'Settings', 'settings']],
    TEACHER: [['dashboard', 'Dashboard', 'grid'], ['batches', 'My Batches', 'layers'], ['attendance', 'Attendance', 'clipboard'], ['assignments', 'Assignments', 'file'],
      ['materials', 'Study Material', 'book'], ['results', 'Results', 'award'], ['timetable', 'Timetable', 'clock'], ['events', 'Events', 'calendar'], ['notifications', 'Notifications', 'bell']],
    STUDENT: [['dashboard', 'Dashboard', 'grid'], ['timetable', 'Timetable', 'clock'], ['attendance', 'Attendance', 'clipboard'], ['assignments', 'Assignments', 'file'],
      ['materials', 'Study Material', 'book'], ['results', 'Results', 'award'], ['fees', 'Fees', 'rupee'], ['events', 'Events', 'calendar'], ['notifications', 'Notifications', 'bell']]
  };
  var BOTTOM = { ADMIN: ['dashboard', 'students', 'attendance', 'fees'], TEACHER: ['dashboard', 'attendance', 'assignments', 'results'], STUDENT: ['dashboard', 'attendance', 'assignments', 'fees'] };
  var ROLE_LABEL = { ADMIN: 'Administrator', TEACHER: 'Teacher', STUDENT: 'Student' };

  function navFor() { return NAV[App.state.user.role] || []; }
  function label(route) { var n = navFor().filter(function (x) { return x[0] === route; })[0]; return n ? n[1] : ''; }

  App.renderShell = function () {
    var u = App.state.user, info = App.state.info || {}, nav = navFor();
    var side = nav.map(function (n) {
      return '<a href="#" data-go="' + n[0] + '" data-nav="' + n[0] + '">' + icon(n[2]) + '<span>' + esc(n[1]) + '</span>' + (n[0] === 'approvals' ? '<span class="count hidden" id="cnt-approvals"></span>' : '') + '</a>';
    }).join('');
    var bottom = BOTTOM[u.role].map(function (r) {
      var n = nav.filter(function (x) { return x[0] === r; })[0];
      return '<a href="#" data-go="' + r + '" data-nav="' + r + '">' + icon(n[2]) + '<span>' + esc(n[1].split(' ')[0]) + '</span></a>';
    }).join('') + '<a href="#" data-more>' + icon('menu') + '<span>More</span></a>';
    $('#app').innerHTML =
      '<div class="shell"><aside class="sidebar" id="sidebar" aria-label="Main navigation">' +
      '<div class="brand"><div class="logo">' + App.logoHtml(info) + '</div><div><div class="name">' + esc(info.name || 'Success Coaching Classes') + '</div><div class="role">' + esc(ROLE_LABEL[u.role]) + ' portal</div></div></div>' +
      '<nav class="nav">' + side + '</nav><div class="side-foot">' + esc(info.academicYear ? 'Academic year ' + info.academicYear : '') + '</div></aside>' +
      '<div class="scrim" id="scrim"></div>' +
      '<div class="main"><header class="topbar"><button type="button" class="icon-btn menu-btn" id="menu-btn" aria-label="Open menu">' + icon('menu') + '</button>' +
      '<h2 id="page-title"></h2><div class="grow"></div>' +
      '<button type="button" class="icon-btn" id="bell" aria-label="Notifications" data-go="notifications">' + icon('bell') + '<span class="dot hidden" id="bell-dot"></span></button>' +
      '<button type="button" class="user-chip" id="user-chip" aria-haspopup="true" aria-expanded="false">' + ui.avatar(u.name) + '<span class="who"><b>' + esc(u.name) + '</b><span>' + esc(ROLE_LABEL[u.role]) + '</span></span></button></header>' +
      '<main class="view" id="view" tabindex="-1" aria-live="polite"></main></div>' +
      '<nav class="bottom-nav" aria-label="Quick navigation">' + bottom + '</nav></div>';
    App.setUnread(App.state.user.unread || 0);
  };

  App.setUnread = function (n) {
    App.state.unread = n;
    var d = $('#bell-dot');
    if (d) { d.textContent = n > 99 ? '99+' : n; d.classList.toggle('hidden', !n); }
  };
  App.setApprovals = function (n) {
    var c = $('#cnt-approvals');
    if (c) { c.textContent = n; c.classList.toggle('hidden', !n); }
  };
  App.refreshMe = function (force) {
    var now = Date.now();
    if (!force && now - (App.state.lastMe || 0) < 120000) return;
    App.state.lastMe = now;
    App.api('auth.me').then(function (d) { App.state.user = d.user; App.setUnread(d.user.unread || 0); }).catch(function () { /* ignore */ });
  };

  function closeDrawer() { var s = $('#sidebar'), sc = $('#scrim'); if (s) s.classList.remove('open'); if (sc) sc.classList.remove('show'); }
  function closeMenu() { var m = $('#user-menu'); if (m) m.remove(); var c = $('#user-chip'); if (c) c.setAttribute('aria-expanded', 'false'); }

  App.go = function (route, params) {
    var u = App.state.user;
    if (!u) return;
    if (!App.pages[route] || !navFor().some(function (n) { return n[0] === route; })) route = 'dashboard';
    App.state.route = route; App.state.params = params || {};
    $$('[data-nav]').forEach(function (a) { if (a.dataset.nav === route) a.setAttribute('aria-current', 'page'); else a.removeAttribute('aria-current'); });
    $('#page-title').textContent = label(route);
    document.title = label(route) + ' \u2014 ' + (App.state.info.name || 'Portal');
    closeDrawer(); closeMenu();
    var view = $('#view');
    view.innerHTML = ui.pageSkeleton();
    view.scrollTop = 0; window.scrollTo(0, 0);
    var token = (App.state.navToken = (App.state.navToken || 0) + 1);
    try {
      var r = App.pages[route].render(view, App.state.params, token);
      if (r && r.catch) r.catch(function (e) { if (token === App.state.navToken) pageError(view, e); });
    } catch (e) { pageError(view, e); }
    if (u.role !== 'ADMIN') App.refreshMe(false);
  };
  /** Pages call this to check they are still the visible page before painting async results. */
  App.stillHere = function (token) { return token === App.state.navToken; };

  function pageError(view, e) {
    if (e && e.code === 'AUTH') return;
    view.innerHTML = '<div class="card">' + ui.empty({ icon: 'alert', title: 'This page could not be loaded', text: (e && e.message) || 'Please try again.', action: '<button type="button" class="btn" id="retry-page">Try again</button>' }) + '</div>';
    var b = $('#retry-page'); if (b) b.onclick = function () { App.go(App.state.route, App.state.params); };
  }

  App.startSession = function (d) {
    App.state.token = d.token; App.state.user = d.user; App.state.info = d.info || App.state.info; App.state.cache = {}; App.state.lastMe = Date.now();
    App.store.set('scc_token', d.token);
    App.renderShell();
    App.go('dashboard');
  };

  // shell-level events (delegated once)
  document.addEventListener('click', function (e) {
    if (e.target.closest('#menu-btn')) { $('#sidebar').classList.add('open'); $('#scrim').classList.add('show'); return; }
    if (e.target.closest('#scrim')) { closeDrawer(); return; }
    if (e.target.closest('[data-more]')) { e.preventDefault(); $('#sidebar').classList.add('open'); $('#scrim').classList.add('show'); return; }
    var chip = e.target.closest('#user-chip');
    if (chip) {
      if ($('#user-menu')) { closeMenu(); return; }
      var u = App.state.user, m = document.createElement('div');
      m.className = 'menu'; m.id = 'user-menu'; m.setAttribute('role', 'menu');
      m.innerHTML = '<div style="padding:10px 12px;border-bottom:1px solid var(--border);margin-bottom:4px"><b class="small">' + esc(u.name) + '</b><div class="xs muted">' + esc(u.username) + '</div></div>' +
        '<button type="button" role="menuitem" data-menu="pw">' + icon('lock') + ' Change password</button><button type="button" role="menuitem" data-menu="out">' + icon('logout') + ' Sign out</button>';
      $('.main').appendChild(m); chip.setAttribute('aria-expanded', 'true');
      return;
    }
    var mi = e.target.closest('[data-menu]');
    if (mi) { closeMenu(); if (mi.dataset.menu === 'out') App.logout(); else App.changePasswordDialog(); return; }
    if (!e.target.closest('#user-menu')) closeMenu();
  });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') { closeMenu(); closeDrawer(); } });

  /* ---------------------------------------------------------------- boot */
  function boot() {
    App.api('public.info').then(function (info) {
      App.state.info = info;
      document.title = (info.name || 'Portal') + ' Portal';
      var t = App.store.get('scc_token');
      if (!t) { App.renderAuth('login'); return; }
      App.state.token = t;
      return App.api('auth.me').then(function (d) {
        App.state.user = d.user; App.state.info = d.info; App.state.lastMe = Date.now();
        App.renderShell(); App.go('dashboard');
      }).catch(function (e) {
        if (e.code !== 'AUTH') App.renderAuth('login');
      });
    }).catch(function (e) {
      $('#app').innerHTML = '<div style="min-height:100vh;display:grid;place-items:center;padding:24px"><div class="card card-pad center" style="max-width:420px">' +
        ui.empty({ icon: 'alert', title: 'Portal is not available', text: e.message || 'Please try again in a moment.', action: '<button type="button" class="btn" onclick="location.reload()">Reload</button>' }) + '</div></div>';
    });
  }
  App.boot = boot;
  boot();
})();
</script>
</body>
</html>
